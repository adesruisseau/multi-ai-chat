@page "/register"
@model AgentGroupChat.BlazorServer.Pages.RegisterModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Register";
    ViewData["BodyClass"] = "auth-page";
}
<head>
    <link href="css/site.css" rel="stylesheet" />
</head>
<body>
<div class="auth-shell">
    <div class="auth-panel auth-panel--compact">
        <section class="auth-hero auth-hero--cool">
            <p class="auth-eyebrow">Agent Group Chat</p>
            <h1 class="auth-display">Create an operator account for your next session.</h1>
            <p class="auth-lead">
                Set up a local identity so rooms, settings, and shared memory have a consistent user behind them.
            </p>
            <div class="auth-tags" aria-hidden="true">
                <span class="auth-tag">Identity</span>
                <span class="auth-tag">Settings</span>
                <span class="auth-tag">Shared Rooms</span>
            </div>
        </section>

        <section class="auth-card">
            <div class="auth-card-header">
                <h2>Create account</h2>
                <p>Register once, then route back into the app.</p>
            </div>

            <form method="post" asp-page-handler="Register" class="auth-form">
                <input asp-for="ReturnUrl" type="hidden" />

                    <div class="mb-3" style="display: flex; justify-content: space-between; align-items: center;">
                    <label asp-for="RegisterInput.Email" class="form-label auth-label"></label>
                    <div>
                    <input asp-for="RegisterInput.Email" class="form-control auth-input" autocomplete="email" />
                    <span asp-validation-for="RegisterInput.Email" class="text-danger"></span>
                        </div>
                </div>
                <br />
                    <div class="mb-3" style="display: flex; justify-content: space-between; align-items: center;">
                    <label asp-for="RegisterInput.UserName" class="form-label auth-label"></label>
                    <div>
                    <input asp-for="RegisterInput.UserName" class="form-control auth-input" autocomplete="username" />
                    <span asp-validation-for="RegisterInput.UserName" class="text-danger"></span>
                        </div>
                </div>
                    <br />
                    <div class="mb-3" style="display: flex; justify-content: space-between; align-items: center;">
                    <label asp-for="RegisterInput.Password" class="form-label auth-label"></label>
                    <div>
                    <input asp-for="RegisterInput.Password" class="form-control auth-input" autocomplete="new-password" />
                    <span asp-validation-for="RegisterInput.Password" class="text-danger"></span>
                        </div>
                </div>
                    <br />
                    <div class="mb-3" style="display: flex; justify-content: space-between; align-items: center;">
                    <label asp-for="RegisterInput.ConfirmPassword" class="form-label auth-label"></label>
                    <div>
                    <input asp-for="RegisterInput.ConfirmPassword" class="form-control auth-input" autocomplete="new-password" />
                    <span asp-validation-for="RegisterInput.ConfirmPassword" class="text-danger"></span>
                        </div>
                </div>
                    <br />
                <button type="submit" class="btn auth-submit-button">Register</button>
            </form>

            <p class="auth-alt-action">
                Already have an account?
                <a asp-page="/Login" asp-route-returnUrl="@Model.ReturnUrl">Sign in</a>
            </p>
        </section>
    </div>
</div>
</body>