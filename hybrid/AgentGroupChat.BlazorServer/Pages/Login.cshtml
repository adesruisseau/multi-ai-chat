@page "/login"
@model AgentGroupChat.BlazorServer.Pages.LoginPageModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Sign in";
    ViewData["BodyClass"] = "auth-page";
}
<head>
    <link href="css/site.css" rel="stylesheet" />
</head>
<body>
<div class="auth-shell">
    <div class="auth-panel auth-panel--compact">
        <section class="auth-hero">
            <p class="auth-eyebrow">Agent Group Chat</p>
            <h1 class="auth-display">Return to the room without losing the thread.</h1>
            <p class="auth-lead">
                Step back into your rooms, prompts, memory logs, and active scenes with the same identity that owns them.
            </p>
            <div class="auth-tags" aria-hidden="true">
                <span class="auth-tag">Rooms</span>
                <span class="auth-tag">Prompt Library</span>
                <span class="auth-tag">Scene Memory</span>
            </div>
        </section>

        <section class="auth-card">
            <div class="auth-card-header">
                <h2>Sign in</h2>
                <p>Use your username and password to continue.</p>
            </div>

            <form method="post" asp-page-handler="Login" class="auth-form">
                <input asp-for="ReturnUrl" type="hidden" />

                <div class="mb-3" style="display: flex; justify-content: space-between; align-items: center;">
                    <label asp-for="LoginInput.UserName" class="form-label auth-label"></label>
                    <div>
                    <input asp-for="LoginInput.UserName" class="form-control auth-input" autocomplete="username" />
                    <span asp-validation-for="LoginInput.UserName" class="text-danger"></span>
                        </div>
                </div>
                <br />

                <div class="mb-3" style="display: flex; justify-content: space-between; align-items: center;">
                    <label asp-for="LoginInput.Password" class="form-label auth-label"></label>
                    <div>
                    <input asp-for="LoginInput.Password" class="form-control auth-input" autocomplete="current-password" />
                    <span asp-validation-for="LoginInput.Password" class="text-danger"></span>
                        </div>
                </div>
                    <br />
                <button type="submit" class="btn auth-submit-button">Login</button>
            </form>

            <p class="auth-alt-action">
                Need an account?
                <a asp-page="/Register" asp-route-returnUrl="@Model.ReturnUrl">Create one</a>
            </p>
        </section>
    </div>
</div>
</body>