@page "/logs"
@inject AgentGroupChat.Core.Services.LogService LogService
@inject RoomState RoomState
@inject AgentGroupChat.Core.Services.Interfaces.IMemoryRepository MemoryRepo
@implements IDisposable

<MudText Typo="Typo.h4" GutterBottom="true">Logs</MudText>

<MudGrid>
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudText Typo="Typo.h6">Shared Room Memory</MudText>
                <MudSpacer />
                @if (RoomState.SelectedRoom is not null)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small"
                               OnClick="ClearSharedRoomMemory">Clear</MudButton>
                }
            </MudStack>
            @if (RoomState.SelectedRoom is null)
            {
                <MudText Typo="Typo.body2" Class="mt-2" Color="Color.Secondary">Select a room to view memory.</MudText>
            }
            else
            {
                <MudText Typo="Typo.caption" Class="mb-1">Room: @RoomState.SelectedRoom.Name</MudText>
                <MudText Typo="Typo.caption" Class="mb-2" Color="Color.Secondary">@BuildMemoryMeta(FindMemoryBlock(null, MemoryKind.SharedRoom))</MudText>
                <pre style="white-space:pre-wrap; max-height:300px; overflow-y:auto; margin:0">@_sharedRoomMemory</pre>
            }
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudText Typo="Typo.h6">Durable Memory</MudText>
                <MudSpacer />
                @if (RoomState.SelectedRoom is not null)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small"
                               OnClick="ClearDurableMemory">Clear</MudButton>
                }
            </MudStack>
            @if (RoomState.SelectedRoom is null)
            {
                <MudText Typo="Typo.body2" Class="mt-2" Color="Color.Secondary">Select a room to view memory.</MudText>
            }
            else
            {
                <MudText Typo="Typo.caption" Class="mb-1">Room: @RoomState.SelectedRoom.Name</MudText>
                <MudText Typo="Typo.caption" Class="mb-2" Color="Color.Secondary">@BuildMemoryMeta(FindMemoryBlock(null, MemoryKind.Durable))</MudText>
                <pre style="white-space:pre-wrap; max-height:300px; overflow-y:auto; margin:0">@_durableMemory</pre>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
        <MudText Typo="Typo.h6">Agent Memory Inspector</MudText>
        <MudSpacer />
        @if (RoomState.SelectedRoom is not null)
        {
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">@($"{_memoryBlocks.Count(b => !string.IsNullOrWhiteSpace(b.Content))} stored blocks")</MudChip>
        }
    </MudStack>
    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
        Short-term scratchpads come from each agent's last few self-turns. Long-term memory stays available for future promotion and manual inspection.
    </MudText>

    @if (RoomState.SelectedRoom is null)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">Select a room to inspect agent memory.</MudText>
    }
    else if (RoomState.SelectedRoom.Agents.Count == 0)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">This room has no agents yet.</MudText>
    }
    else
    {
        @foreach (var agent in RoomState.SelectedRoom.Agents)
        {
            var shortBlock = FindMemoryBlock(agent.Id, MemoryKind.AgentShort);
            var longBlock = FindMemoryBlock(agent.Id, MemoryKind.AgentLong);

            <MudPaper Class="pa-3 mb-3" Elevation="0" Outlined="true">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                    <MudText Typo="Typo.subtitle1">@agent.Name</MudText>
                    <MudSpacer />
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@BuildAgentMemorySummary(shortBlock, longBlock)</MudChip>
                </MudStack>

                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudText Typo="Typo.caption" Class="mb-1">Short-Term Scratchpad</MudText>
                        <MudText Typo="Typo.caption" Class="mb-2" Color="Color.Secondary">@BuildMemoryMeta(shortBlock)</MudText>
                        <pre style="white-space:pre-wrap; max-height:220px; overflow-y:auto; margin:0">@RenderMemory(shortBlock, "(No short-term scratchpad yet.)")</pre>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudText Typo="Typo.caption" Class="mb-1">Long-Term Agent Memory</MudText>
                        <MudText Typo="Typo.caption" Class="mb-2" Color="Color.Secondary">@BuildMemoryMeta(longBlock)</MudText>
                        <pre style="white-space:pre-wrap; max-height:220px; overflow-y:auto; margin:0">@RenderMemory(longBlock, "(No long-term agent memory yet.)")</pre>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        }
    }
</MudPaper>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="flex-wrap">
        @foreach (var cat in _allCategories)
        {
            var isActive = _activeCategories.Contains(cat);
            <MudTooltip Text="@cat">
                <MudIconButton Icon="@CategoryIcon(cat)"
                               Color="@(isActive ? CategoryColor(cat) : Color.Default)"
                               Variant="@(isActive ? Variant.Filled : Variant.Outlined)"
                               Size="Size.Small"
                               OnClick="@(() => ToggleCategory(cat))" />
            </MudTooltip>
        }
        <MudDivider Vertical="true" FlexItem="true" Class="mx-2" />
        <MudSelect Value="_sourceFilter" Label="Source" Style="max-width:180px" T="string"
                   ValueChanged="OnSourceFilterChanged">
            <MudSelectItem T="string" Value="@string.Empty">All</MudSelectItem>
            @foreach (var source in _sources)
            {
                <MudSelectItem T="string" Value="@source">@source</MudSelectItem>
            }
        </MudSelect>
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RefreshAll" Size="Size.Small">Refresh</MudButton>
    </MudStack>
</MudPaper>

<MudPaper Elevation="1">
    <MudTable Items="_entries" Dense="true" Hover="true" Striped="true" FixedHeader="true" Height="500px">
        <HeaderContent>
            <MudTh Style="width:90px">Category</MudTh>
            <MudTh Style="width:110px">Source</MudTh>
            <MudTh>Message</MudTh>
            <MudTh Style="width:80px">Duration</MudTh>
            <MudTh Style="width:80px">Time</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.CategoryText</MudTd>
            <MudTd>@context.Source</MudTd>
            <MudTd>
                @if (context.HasDetail)
                {
                    <MudStack Spacing="0">
                        <MudLink Typo="Typo.body2" Color="Color.Primary" OnClick="@(() => ToggleDetail(context.Id))"
                                 Style="cursor:pointer">
                            @context.Message
                            <MudIcon Icon="@(_expandedIds.Contains(context.Id) ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                     Size="Size.Small" Class="ml-1" />
                        </MudLink>
                        @if (_expandedIds.Contains(context.Id))
                        {
                            <MudPaper Class="pa-2 mt-1" Elevation="0" Style="background:var(--mud-palette-background-gray); max-height:400px; overflow-y:auto;">
                                <pre style="white-space:pre-wrap; margin:0; font-size:0.8rem;">@context.Detail</pre>
                            </MudPaper>
                        }
                    </MudStack>
                }
                else
                {
                    <MudText Typo="Typo.body2">@context.Message</MudText>
                }
            </MudTd>
            <MudTd>@context.DurationText</MudTd>
            <MudTd>@context.CreatedAt.ToString("HH:mm:ss")</MudTd>
        </RowTemplate>
    </MudTable>
</MudPaper>

@code {
    private const int MaxLogEntries = 50;
    private static readonly string[] _allCategories = Enum.GetNames<LogCategory>();
    private readonly HashSet<string> _activeCategories = new(Enum.GetNames<LogCategory>());
    private readonly HashSet<long> _expandedIds = new();

    private List<LogEntry> _entries = new();
    private List<string> _sources = new();
    private List<MemoryBlock> _memoryBlocks = new();
    private string _sourceFilter = string.Empty;
    private string _sharedRoomMemory = string.Empty;
    private string _durableMemory = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        LogService.OnEntryAdded += OnEntryAdded;
        RoomState.OnChange += OnRoomChanged;
        await RefreshAll();
    }

    private async Task Refresh()
    {
        _sources = await LogService.GetSourcesAsync();

        if (_activeCategories.Count == _allCategories.Length)
        {
            // All active = no category filter
            _entries = await LogService.QueryAsync(
                null,
                string.IsNullOrWhiteSpace(_sourceFilter) ? null : _sourceFilter,
                MaxLogEntries);
        }
        else if (_activeCategories.Count == 0)
        {
            _entries = new();
        }
        else
        {
            // Fetch per active category then merge and trim
            var merged = new List<LogEntry>();
            foreach (var cat in _activeCategories)
            {
                merged.AddRange(await LogService.QueryAsync(
                    cat,
                    string.IsNullOrWhiteSpace(_sourceFilter) ? null : _sourceFilter,
                    MaxLogEntries));
            }
            _entries = merged.OrderBy(e => e.Id).TakeLast(MaxLogEntries).ToList();
        }
    }

    private async Task ToggleCategory(string category)
    {
        if (!_activeCategories.Remove(category))
            _activeCategories.Add(category);
        await Refresh();
    }

    private async Task OnSourceFilterChanged(string value)
    {
        _sourceFilter = value;
        await Refresh();
    }

    private void ToggleDetail(long id)
    {
        if (!_expandedIds.Remove(id))
            _expandedIds.Add(id);
    }

    private static string CategoryIcon(string category) => category switch
    {
        "System"   => Icons.Material.Filled.Settings,
        "Speech"   => Icons.Material.Filled.RecordVoiceOver,
        "Timing"   => Icons.Material.Filled.Timer,
        "Request"  => Icons.Material.Filled.CallMade,
        "Response" => Icons.Material.Filled.CallReceived,
        "Memory"   => Icons.Material.Filled.Psychology,
        _          => Icons.Material.Filled.Info,
    };

    private static Color CategoryColor(string category) => category switch
    {
        "System"   => Color.Info,
        "Speech"   => Color.Success,
        "Timing"   => Color.Warning,
        "Request"  => Color.Primary,
        "Response" => Color.Secondary,
        "Memory"   => Color.Tertiary,
        _          => Color.Default,
    };

    private async Task RefreshAll()
    {
        await Refresh();
        await RefreshMemory();
    }

    private async Task RefreshMemory()
    {
        if (RoomState.SelectedRoom is null)
        {
            _memoryBlocks = new();
            _sharedRoomMemory = string.Empty;
            _durableMemory = string.Empty;
            return;
        }

        _memoryBlocks = (await MemoryRepo.GetBlocksAsync(RoomState.SelectedRoom.Id)).ToList();
        _sharedRoomMemory = FindMemoryBlock(null, MemoryKind.SharedRoom)?.Content ?? string.Empty;
        _durableMemory = FindMemoryBlock(null, MemoryKind.Durable)?.Content ?? string.Empty;
    }

    private async Task ClearSharedRoomMemory()
    {
        if (RoomState.SelectedRoom is null) return;
        await MemoryRepo.SaveAsync(RoomState.SelectedRoom.Id, null, MemoryKind.SharedRoom, string.Empty);
        await RefreshMemory();
    }

    private async Task ClearDurableMemory()
    {
        if (RoomState.SelectedRoom is null) return;
        await MemoryRepo.SaveAsync(RoomState.SelectedRoom.Id, null, MemoryKind.Durable, string.Empty);
        await RefreshMemory();
    }

    private MemoryBlock? FindMemoryBlock(string? agentId, MemoryKind kind) =>
        _memoryBlocks.FirstOrDefault(block => block.AgentId == agentId && block.Kind == kind);

    private static string BuildMemoryMeta(MemoryBlock? block)
    {
        if (block is null || string.IsNullOrWhiteSpace(block.Content))
            return "No stored content yet.";

        return $"{block.Content.Length} chars • updated {block.UpdatedAt.LocalDateTime:g}";
    }

    private static string BuildAgentMemorySummary(MemoryBlock? shortBlock, MemoryBlock? longBlock)
    {
        var blockCount = 0;
        var totalChars = 0;

        if (!string.IsNullOrWhiteSpace(shortBlock?.Content))
        {
            blockCount++;
            totalChars += shortBlock.Content.Length;
        }

        if (!string.IsNullOrWhiteSpace(longBlock?.Content))
        {
            blockCount++;
            totalChars += longBlock.Content.Length;
        }

        return blockCount == 0 ? "No private memory" : $"{blockCount} blocks • {totalChars} chars";
    }

    private static string RenderMemory(MemoryBlock? block, string emptyText) =>
        string.IsNullOrWhiteSpace(block?.Content) ? emptyText : block.Content;

    private void OnEntryAdded(LogEntry entry)
    {
        InvokeAsync(async () =>
        {
            await Refresh();
            if (entry.Category == LogCategory.Memory)
                await RefreshMemory();
            StateHasChanged();
        });
    }

    private void OnRoomChanged()
    {
        InvokeAsync(async () =>
        {
            await RefreshMemory();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        LogService.OnEntryAdded -= OnEntryAdded;
        RoomState.OnChange -= OnRoomChanged;
    }
}
