@page "/logs"
@inject AgentGroupChat.Core.Services.LogService LogService
@inject RoomState RoomState
@inject AgentGroupChat.Core.Services.Interfaces.IMemoryRepository MemoryRepo
@implements IDisposable

<MudText Typo="Typo.h4" GutterBottom="true">Logs</MudText>

<MudGrid>
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudText Typo="Typo.h6">Shared Room Memory</MudText>
                <MudSpacer />
                @if (RoomState.SelectedRoom is not null)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small"
                               OnClick="ClearSharedRoomMemory">Clear</MudButton>
                }
            </MudStack>
            @if (RoomState.SelectedRoom is null)
            {
                <MudText Typo="Typo.body2" Class="mt-2" Color="Color.Secondary">Select a room to view memory.</MudText>
            }
            else
            {
                <MudText Typo="Typo.caption" Class="mb-1">Room: @RoomState.SelectedRoom.Name</MudText>
                <pre style="white-space:pre-wrap; max-height:300px; overflow-y:auto; margin:0">@_sharedRoomMemory</pre>
            }
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudText Typo="Typo.h6">Durable Memory</MudText>
                <MudSpacer />
                @if (RoomState.SelectedRoom is not null)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small"
                               OnClick="ClearDurableMemory">Clear</MudButton>
                }
            </MudStack>
            @if (RoomState.SelectedRoom is null)
            {
                <MudText Typo="Typo.body2" Class="mt-2" Color="Color.Secondary">Select a room to view memory.</MudText>
            }
            else
            {
                <MudText Typo="Typo.caption" Class="mb-1">Room: @RoomState.SelectedRoom.Name</MudText>
                <pre style="white-space:pre-wrap; max-height:300px; overflow-y:auto; margin:0">@_durableMemory</pre>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="flex-wrap">
        @foreach (var cat in _allCategories)
        {
            var isActive = _activeCategories.Contains(cat);
            <MudTooltip Text="@cat">
                <MudIconButton Icon="@CategoryIcon(cat)"
                               Color="@(isActive ? CategoryColor(cat) : Color.Default)"
                               Variant="@(isActive ? Variant.Filled : Variant.Outlined)"
                               Size="Size.Small"
                               OnClick="@(() => ToggleCategory(cat))" />
            </MudTooltip>
        }
        <MudDivider Vertical="true" FlexItem="true" Class="mx-2" />
        <MudSelect Value="_sourceFilter" Label="Source" Style="max-width:180px" T="string"
                   ValueChanged="OnSourceFilterChanged">
            <MudSelectItem T="string" Value="@string.Empty">All</MudSelectItem>
            @foreach (var source in _sources)
            {
                <MudSelectItem T="string" Value="@source">@source</MudSelectItem>
            }
        </MudSelect>
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Refresh" Size="Size.Small">Refresh</MudButton>
    </MudStack>
</MudPaper>

<MudPaper Elevation="1">
    <MudTable Items="_entries" Dense="true" Hover="true" Striped="true" FixedHeader="true" Height="500px">
        <HeaderContent>
            <MudTh>Category</MudTh>
            <MudTh>Source</MudTh>
            <MudTh>Message</MudTh>
            <MudTh>Duration</MudTh>
            <MudTh>Time</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.CategoryText</MudTd>
            <MudTd>@context.Source</MudTd>
            <MudTd>
                <MudText Typo="Typo.body2">@context.Message</MudText>
                @if (context.HasDetail)
                {
                    <MudText Typo="Typo.caption" Style="white-space:pre-wrap">@context.Detail</MudText>
                }
            </MudTd>
            <MudTd>@context.DurationText</MudTd>
            <MudTd>@context.CreatedAt.ToString("HH:mm:ss")</MudTd>
        </RowTemplate>
    </MudTable>
</MudPaper>

@code {
    private const int MaxLogEntries = 50;
    private static readonly string[] _allCategories = Enum.GetNames<LogCategory>();
    private readonly HashSet<string> _activeCategories = new(Enum.GetNames<LogCategory>());

    private List<LogEntry> _entries = new();
    private List<string> _sources = new();
    private string _sourceFilter = string.Empty;
    private string _sharedRoomMemory = string.Empty;
    private string _durableMemory = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        LogService.OnEntryAdded += OnEntryAdded;
        RoomState.OnChange += OnRoomChanged;
        await Refresh();
        await RefreshMemory();
    }

    private async Task Refresh()
    {
        _sources = await LogService.GetSourcesAsync();

        if (_activeCategories.Count == _allCategories.Length)
        {
            // All active = no category filter
            _entries = await LogService.QueryAsync(
                null,
                string.IsNullOrWhiteSpace(_sourceFilter) ? null : _sourceFilter,
                MaxLogEntries);
        }
        else if (_activeCategories.Count == 0)
        {
            _entries = new();
        }
        else
        {
            // Fetch per active category then merge and trim
            var merged = new List<LogEntry>();
            foreach (var cat in _activeCategories)
            {
                merged.AddRange(await LogService.QueryAsync(
                    cat,
                    string.IsNullOrWhiteSpace(_sourceFilter) ? null : _sourceFilter,
                    MaxLogEntries));
            }
            _entries = merged.OrderBy(e => e.Id).TakeLast(MaxLogEntries).ToList();
        }
    }

    private async Task ToggleCategory(string category)
    {
        if (!_activeCategories.Remove(category))
            _activeCategories.Add(category);
        await Refresh();
    }

    private async Task OnSourceFilterChanged(string value)
    {
        _sourceFilter = value;
        await Refresh();
    }

    private static string CategoryIcon(string category) => category switch
    {
        "System"   => Icons.Material.Filled.Settings,
        "Speech"   => Icons.Material.Filled.RecordVoiceOver,
        "Timing"   => Icons.Material.Filled.Timer,
        "Request"  => Icons.Material.Filled.CallMade,
        "Response" => Icons.Material.Filled.CallReceived,
        "Memory"   => Icons.Material.Filled.Psychology,
        _          => Icons.Material.Filled.Info,
    };

    private static Color CategoryColor(string category) => category switch
    {
        "System"   => Color.Info,
        "Speech"   => Color.Success,
        "Timing"   => Color.Warning,
        "Request"  => Color.Primary,
        "Response" => Color.Secondary,
        "Memory"   => Color.Tertiary,
        _          => Color.Default,
    };

    private async Task RefreshMemory()
    {
        if (RoomState.SelectedRoom is null) return;
        _sharedRoomMemory = await MemoryRepo.GetAsync(RoomState.SelectedRoom.Id, null, MemoryKind.SharedRoom);
        _durableMemory = await MemoryRepo.GetAsync(RoomState.SelectedRoom.Id, null, MemoryKind.Durable);
    }

    private async Task ClearSharedRoomMemory()
    {
        if (RoomState.SelectedRoom is null) return;
        await MemoryRepo.SaveAsync(RoomState.SelectedRoom.Id, null, MemoryKind.SharedRoom, string.Empty);
        _sharedRoomMemory = string.Empty;
    }

    private async Task ClearDurableMemory()
    {
        if (RoomState.SelectedRoom is null) return;
        await MemoryRepo.SaveAsync(RoomState.SelectedRoom.Id, null, MemoryKind.Durable, string.Empty);
        _durableMemory = string.Empty;
    }

    private void OnEntryAdded(LogEntry entry)
    {
        InvokeAsync(async () =>
        {
            await Refresh();
            StateHasChanged();
        });
    }

    private void OnRoomChanged()
    {
        InvokeAsync(async () =>
        {
            await RefreshMemory();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        LogService.OnEntryAdded -= OnEntryAdded;
        RoomState.OnChange -= OnRoomChanged;
    }
}
