@page "/"
@inject AppState AppState
@inject RoomState RoomState
<MudGrid Justify="Justify.Center">
    <MudItem xs="8" >

<MudText Typo="Typo.h4" GutterBottom="true">First-Time Setup</MudText>
<MudText Typo="Typo.body1" Class="mb-4">Follow these steps to get started. Complete them in any order.</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudText Typo="Typo.h6">What This App Does</MudText>
    <MudText Typo="Typo.body2" Class="mt-2">
        Agent Group Chat lets you configure AI services and models, build themed rooms of agents,
        and run shared conversations where each agent responds in sequence. The Chat tab is where the room
        talks together, while the optional speech features can narrate the conversation out loud.
    </MudText>
</MudPaper>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudText Typo="Typo.h6">Setup Progress</MudText>
    <MudText Typo="Typo.body2" Class="mt-2">@ProgressText</MudText>
    <MudProgressLinear Value="@CompletedSteps" Max="3" Class="my-3" Color="Color.Primary" />

    <MudText Typo="Typo.subtitle1" Class="mt-2">@(AppState.Settings.SetupModelsCompleted ? "✓" : "○") AI Models</MudText>
    <MudText Typo="Typo.body2" Class="ml-4">Save AI settings, add a model, or pass a model connection test to complete this step.</MudText>

    <MudText Typo="Typo.subtitle1" Class="mt-2">@(AppState.Settings.SetupRoomsCompleted ? "✓" : "○") Rooms</MudText>
    <MudText Typo="Typo.body2" Class="ml-4">Create a room, add an agent, or save room changes to complete this step.</MudText>

    <MudText Typo="Typo.subtitle1" Class="mt-2">@(AppState.Settings.SetupTtsStatus != "Pending" ? "✓" : "○") Text-to-Speech</MudText>
    <MudText Typo="Typo.body2" Class="ml-4">TTS is optional. Configure speech settings on Chat or skip it here.</MudText>

    @if (AppState.Settings.SetupTtsStatus == "Pending")
    {
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Class="mt-2" OnClick="SkipTts">Skip TTS For Now</MudButton>
    }
</MudPaper>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudText Typo="Typo.h6">Recommended Order</MudText>
    <MudList T="string" Dense="true">
        <MudListItem T="string">1. Decide on speech first — go to Chat tab or skip TTS above.</MudListItem>
        <MudListItem T="string">2. Go to AI Models — add connections and catalog entries.</MudListItem>
        <MudListItem T="string">3. Go to Rooms — create a room and add agents.</MudListItem>
        <MudListItem T="string">4. Go to Chat — select a room and start a conversation.</MudListItem>
    </MudList>
</MudPaper>

@if (CompletedSteps >= 3)
{
    <MudAlert Severity="Severity.Success" Class="mb-4">
        Setup complete! You can hide this guide from settings.
    </MudAlert>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="HideGuide">Hide Setup Guide</MudButton>
}

    </MudItem>
</MudGrid>
@code {
    private int CompletedSteps =>
        (AppState.Settings.SetupModelsCompleted ? 1 : 0) +
        (AppState.Settings.SetupRoomsCompleted ? 1 : 0) +
        (AppState.Settings.SetupTtsStatus != "Pending" ? 1 : 0);

    private string ProgressText => $"{CompletedSteps} of 3 steps completed.";

    private async Task SkipTts()
    {
        AppState.Settings.SetupTtsStatus = "Skipped";
        await AppState.SaveSettingsAsync();
    }

    private async Task HideGuide()
    {
        AppState.Settings.HideSetupGuide = true;
        await AppState.SaveSettingsAsync();
    }
}
