@page "/chat"
@inject RoomState RoomState
@inject AppState AppState
@inject ConversationState ConvoState
@inject AgentGroupChat.Core.Services.ConversationRunner Runner
@inject AgentGroupChat.Core.Services.Interfaces.IMemoryRepository MemoryRepo
@inject AgentGroupChat.Core.Services.Interfaces.ITranscriptRepository TranscriptRepo
@inject AgentGroupChat.Core.Services.SpeechService Speech
@inject AgentGroupChat.Core.Services.LogService LogService
@using AgentGroupChat.Core.Services
@using AgentGroupChat.Hybrid.Theming
@implements IDisposable

<MudText Typo="Typo.h4" GutterBottom="true">Chat</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudSelect @bind-Value="_selectedRoomId" Label="Room" Class="flex-grow-1" T="string">
            @foreach (var room in RoomState.Rooms)
            {
                <MudSelectItem T="string" Value="@room.Id">@room.Name</MudSelectItem>
            }
        </MudSelect>
        <MudButton OnClick="LoadRoom" Variant="Variant.Outlined">Load</MudButton>
    </MudStack>
</MudPaper>

@if (RoomState.SelectedRoom is null)
{
    <MudAlert Severity="Severity.Info">Select a room above and click Load to start chatting.</MudAlert>
}
else
{

    <MudPaper Class="pa-4 mb-4" Elevation="1" Style="max-height:500px; overflow-y:auto;">
        @{ var isDark = AppState.Settings.UiTheme == "Dark"; }
        @{ var visibleMessages = ConvoState.Messages.Where(m => !m.IsSystem).ToList(); }
        @for (int i = 0; i < visibleMessages.Count; i++)
        {
            var msg = visibleMessages[i];
            var idx = ConvoState.Messages.IndexOf(msg);
            var preset = msg.IsUser ? null : AgentColorPresets.FindByAccent(msg.AccentHex, isDark);
            var borderColor = msg.IsUser ? (isDark ? "#6EACDF" : "#1976d2") : (preset?.AccentHex ?? msg.AccentHex);
            var bgColor = msg.IsUser ? (isDark ? "#142838" : "#e3f2fd") : (preset?.BackgroundHex ?? msg.BackgroundHex);
            <MudPaper Class="pa-2 mb-2" Elevation="0" Outlined="true"
                      Style="@($"border-left: 4px solid {borderColor}; background: {bgColor}")">
                <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="1">
                    <div style="flex:1; min-width:0;">
                        <MudText Typo="Typo.subtitle2" Style="@($"color:{borderColor}")">@msg.Speaker</MudText>
                        <MudText Typo="Typo.body2" Style="white-space: pre-wrap">@msg.Content</MudText>
                    </div>
                    <MudIconButton Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small"
                                   OnClick="@(() => PlayFromMessage(idx))" Disabled="_isPlayingFrom"
                                   Title="Play from here" />
                </MudStack>
            </MudPaper>
        }
    </MudPaper>

    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudTextField @bind-Value="_userInput" Label="Your message" Class="mb-3" OnKeyDown="OnKeyDown" Lines="4"
                      Immediate="true" />
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudNumericField @bind-Value="_iterations" Label="Rounds" Min="1" Style="max-width:100px" />
            <MudSpacer />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Run" Disabled="ConvoState.IsRunning">Run</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="Stop" Disabled="!ConvoState.IsRunning">Stop</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Warning" OnClick="ClearRoom" Disabled="ConvoState.IsRunning">Clear Room</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Warning" OnClick="ClearLogs" Disabled="ConvoState.IsRunning">Clear Logs</MudButton>
        </MudStack>
        <MudText Typo="Typo.caption" Class="mt-1">@ConvoState.Status</MudText>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudSwitch Value="AppState.Settings.TtsEnabled" Label="Speech" Color="Color.Primary"
                       T="bool" ValueChanged="OnTtsToggled" />
            <MudSelect Value="AppState.Settings.TtsProvider" Label="Provider" T="string" Style="max-width:140px"
                       ValueChanged="@((string v) => OnTtsProviderChanged(v))">
                <MudSelectItem T="string" Value="@("Local")">Local</MudSelectItem>
                <MudSelectItem T="string" Value="@("Piper")">Piper</MudSelectItem>
                <MudSelectItem T="string" Value="@("Kokoro")">Kokoro</MudSelectItem>
            </MudSelect>
            <MudStack Spacing="0" Style="min-width:160px">
                <MudText Typo="Typo.caption">Rate: @AppState.Settings.TtsRate</MudText>
                <MudSlider Value="AppState.Settings.TtsRate" Min="-5" Max="5" Step="1" T="int"
                           ValueChanged="OnTtsRateChanged" Color="Color.Primary" />
            </MudStack>
            <MudSpacer />
            @if (Speech.IsSpeaking)
            {
                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="TogglePause">
                    @(Speech.IsPaused ? "Resume" : "Pause")
                </MudButton>
                @* Issues with halting all API activity currently.
                <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Error" OnClick="StopSpeech">
                    Stop Speech
                </MudButton> *@
            }
        </MudStack>
        @if (AppState.Settings.TtsProvider == "Kokoro")
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2">
                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="TestKokoro" Disabled="_kokoroTesting">
                    @(_kokoroTesting ? "Testing..." : "Test Kokoro")
                </MudButton>
                @if (!string.IsNullOrEmpty(_kokoroTestResult))
                {
                    <MudText Typo="Typo.caption" Color="@(_kokoroTestOk ? Color.Success : Color.Error)">@_kokoroTestResult</MudText>
                }
                @if (!_kokoroTestOk && !string.IsNullOrEmpty(_kokoroTestResult))
                {
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Warning" OnClick="StartKokoroService">
                        Start Service
                    </MudButton>
                }
            </MudStack>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2">
                @if (_kokoroVoices.Count > 0)
                {
                    <MudSelect Value="AppState.Settings.KokoroVoice" Label="Default Agent Voice" T="string" Style="max-width:220px"
                               ValueChanged="OnDefaultVoiceChanged">
                        @foreach (var v in _kokoroVoices)
                        {
                            <MudSelectItem T="string" Value="@v">@v</MudSelectItem>
                        }
                    </MudSelect>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Class="mt-3"
                               OnClick="TestDefaultVoice" Disabled="_previewingVoice">
                        @(_previewingVoice ? "Playing..." : "Test")
                    </MudButton>
                    <MudSelect Value="AppState.Settings.KokoroUserVoice" Label="Your Voice" T="string" Style="max-width:220px"
                               ValueChanged="OnUserVoiceChanged">
                        <MudSelectItem T="string" Value="@string.Empty">(Same as default)</MudSelectItem>
                        @foreach (var v in _kokoroVoices)
                        {
                            <MudSelectItem T="string" Value="@v">@v</MudSelectItem>
                        }
                    </MudSelect>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Class="mt-3"
                               OnClick="TestUserVoice" Disabled="_previewingVoice">
                        @(_previewingVoice ? "Playing..." : "Test")
                    </MudButton>
                }
                else
                {
                    <MudTextField Value="AppState.Settings.KokoroVoice" Label="Default Agent Voice" T="string" Style="max-width:220px"
                                  ValueChanged="OnDefaultVoiceChanged" />
                }
                <MudButton Variant="Variant.Outlined" Size="Size.Small" Class="mt-3" OnClick="RefreshVoices">
                    Refresh Voices
                </MudButton>
            </MudStack>
        }
    </MudPaper>
}

@code {
    private string _selectedRoomId = string.Empty;
    private string _userInput = string.Empty;
    private int _iterations = 1;
    private CancellationTokenSource? _cts;
    private CancellationTokenSource? _playbackCts;
    private bool _isPlayingFrom;
    private bool _kokoroTesting;
    private string _kokoroTestResult = string.Empty;
    private bool _kokoroTestOk;
    private List<string> _kokoroVoices = new();
    private bool _previewingVoice;


    protected override async Task OnInitializedAsync()
    {
        ConvoState.OnChange += OnConvoChanged;
        Runner.OnSystemMessage += OnRunnerSystemMessage;
        Runner.OnAgentMessageStarted += OnRunnerAgentStarted;
        Runner.OnAgentMessageCompleted += OnRunnerAgentCompleted;
        Runner.OnStatusChanged += OnRunnerStatusChanged;
        Runner.OnLog += OnRunnerLog;
        Speech.OnPlaybackStateChanged += OnSpeechStateChanged;

        // Wire TTS speech gate into conversation runner
        Runner.OnSpeechGate = OnSpeechGateAsync;

        if (RoomState.Rooms.Count == 0)
            await RoomState.LoadAsync();

        if (RoomState.SelectedRoom is not null)
        {
            _selectedRoomId = RoomState.SelectedRoom.Id;
            await LoadRoom();
        }
        else if (RoomState.Rooms.Count > 0)
        {
            _selectedRoomId = RoomState.Rooms[0].Id;
        }

        _ = RefreshVoices();
    }

    private void OnRunnerSystemMessage(string msg)
    {
        // System messages are tracked internally but not shown in chat
        ConvoState.SetStatus(msg);
        _ = LogService.LogAsync(LogCategory.System, "Runner", msg);
        InvokeAsync(StateHasChanged);
    }

    private void OnRunnerAgentStarted(AgentConfig agent, string msg)
    {
        ConvoState.AddAgentMessage(agent, msg);
        InvokeAsync(StateHasChanged);
    }

    private void OnRunnerAgentCompleted(AgentConfig agent, string msg)
    {
        // Find the "Thinking..." placeholder specifically for this agent
        var placeholder = ConvoState.Messages.LastOrDefault(
            m => m.Speaker == agent.Name && m.Content == "Thinking...");
        if (placeholder is not null)
        {
            placeholder.Content = msg;
        }
        else
        {
            // No placeholder found (edge case) — add as a new message
            ConvoState.Messages.Add(new ChatMessage
            {
                Speaker = agent.Name,
                Content = msg,
                AccentHex = agent.AccentHex,
                BackgroundHex = agent.BackgroundHex,
            });
        }
        ConvoState.SessionTurns.Add(new TranscriptTurn { Speaker = agent.Name, Content = msg });
        ConvoState.NotifyChanged();
        InvokeAsync(StateHasChanged);
    }

    private void OnRunnerStatusChanged(string status)
    {
        ConvoState.SetStatus(status);
        InvokeAsync(StateHasChanged);
    }

    private void OnRunnerLog(string message)
    {
        // Determine category from message content
        var category = message.Contains("memory", StringComparison.OrdinalIgnoreCase)
            ? LogCategory.Memory
            : LogCategory.Response;
        _ = LogService.LogAsync(category, "Runner", message);
    }

    private async Task LoadRoom()
    {
        var room = RoomState.Rooms.FirstOrDefault(r => r.Id == _selectedRoomId);
        if (room is null) return;
        RoomState.SelectRoom(room);
        ConvoState.Clear();

        var turns = await TranscriptRepo.GetAsync(room.Id);
        foreach (var turn in turns)
        {
            if (turn.Speaker == "You")
                ConvoState.Messages.Add(new ChatMessage { Speaker = "You", Content = turn.Content, IsUser = true });
            else
            {
                var agent = room.Agents.FirstOrDefault(a => a.Name == turn.Speaker);
                ConvoState.Messages.Add(new ChatMessage
                {
                    Speaker = turn.Speaker,
                    Content = turn.Content,
                    AccentHex = agent?.AccentHex ?? "#888",
                    BackgroundHex = agent?.BackgroundHex ?? "transparent",
                });
            }
            ConvoState.SessionTurns.Add(turn);
        }
        ConvoState.NotifyChanged();
    }

    private async Task Run()
    {
        if (RoomState.SelectedRoom is null) return;
        if (ConvoState.IsRunning) return;

        var room = RoomState.SelectedRoom;

        if (!string.IsNullOrWhiteSpace(_userInput))
        {
            ConvoState.AddUserMessage(_userInput);
            await TranscriptRepo.AppendAsync(new TranscriptTurn
            {
                RoomId = room.Id,
                Speaker = "You",
                Content = _userInput,
            });

            // Narrate user message before agents start
            var ttsSettings = BuildSpeechSettings();
            if (ttsSettings.Enabled)
            {
                var userVoice = string.IsNullOrWhiteSpace(AppState.Settings.KokoroUserVoice)
                    ? ttsSettings.KokoroVoice
                    : AppState.Settings.KokoroUserVoice;
                await Speech.SpeakAsync(ttsSettings, _userInput, userVoice, CancellationToken.None);
            }

            _userInput = string.Empty;
        }
        else if (ConvoState.SessionTurns.Count == 0)
        {
            return;
        }

        // Clean up any stale "Thinking..." placeholders from a previous failed run
        ConvoState.Messages.RemoveAll(m => m.Content == "Thinking...");

        ConvoState.IsRunning = true;
        ConvoState.SetStatus("Running");
        _cts = new CancellationTokenSource();

        try
        {
            // Determine which agent to resume from based on the last transcript turn
            var resumeIndex = ComputeResumeAgentIndex(room);

            await Runner.RunAsync(
                room,
                agent => ResolveSettings(agent),
                ResolveSettings(null),
                _iterations,
                ConvoState.CompletedRounds,
                _cts.Token,
                resumeIndex);

            ConvoState.CompletedRounds += _iterations;
        }
        catch (OperationCanceledException)
        {
            ConvoState.AddSystemMessage("Stopped.");
            _ = LogService.LogAsync(LogCategory.System, "Runner", "Run cancelled by user.");
        }
        catch (Exception ex)
        {
            ConvoState.AddSystemMessage($"Error: {ex.Message}");
            _ = LogService.LogAsync(LogCategory.System, "Runner", $"Run failed: {ex.GetType().Name}", ex.Message);
        }
        finally
        {
            // Clean up any leftover "Thinking..." placeholders from failed/cancelled turns
            ConvoState.Messages.RemoveAll(m => m.Content == "Thinking...");
            ConvoState.IsRunning = false;
            ConvoState.SetStatus("Ready");
            ConvoState.NotifyChanged();
            _cts?.Dispose();
            _cts = null;
        }
    }

    private void Stop()
    {
        _cts?.Cancel();
        _playbackCts?.Cancel();
        Speech.Stop();
    }

    private async Task ClearRoom()
    {
        if (RoomState.SelectedRoom is null) return;
        await TranscriptRepo.ClearAsync(RoomState.SelectedRoom.Id);
        await MemoryRepo.ClearAllForRoomAsync(RoomState.SelectedRoom.Id);
        ConvoState.Clear();
    }

    private async Task ClearLogs()
    {
        await LogService.ClearAsync();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey && !ConvoState.IsRunning)
        {
            await Task.Yield();
            await Run();
        }
    }

    private LlmRequestSettings ResolveSettings(AgentConfig? agent)
    {
        var modelId = agent?.ModelId ?? RoomState.SelectedRoom?.SummarizerModelId ?? string.Empty;
        var catalogEntry = AppState.Models.FirstOrDefault(m => m.Id == modelId)
                        ?? AppState.Models.FirstOrDefault(m => string.Equals(m.Name, modelId, StringComparison.OrdinalIgnoreCase));
        if (catalogEntry is null)
            throw new InvalidOperationException($"Model '{modelId}' not found in catalog.");

        var connection = AppState.Connections.FirstOrDefault(c => c.Id == catalogEntry.ConnectionId);
        if (connection is null)
            throw new InvalidOperationException($"Connection '{catalogEntry.ConnectionId}' not found.");

        var provider = connection.Transport switch
        {
            "Groq" => LlmProvider.Groq,
            "Gemini" => LlmProvider.Gemini,
            "HuggingFace" => LlmProvider.HuggingFace,
            "Ollama" => LlmProvider.Ollama,
            _ => LlmProvider.OpenAiCompatible,
        };

        var maxCompletionTokens = agent?.MaxTokensOverride
            ?? (agent is null
                ? (RoomState.SelectedRoom?.SummarizerMaxTokens >= 140
                    ? RoomState.SelectedRoom.SummarizerMaxTokens
                    : RoomState.SelectedRoom?.MaxTokens)
                : RoomState.SelectedRoom?.MaxTokens)
            ?? 300;

        return new LlmRequestSettings(
            provider,
            connection.Endpoint,
            catalogEntry.ModelId,
            connection.ApiKey,
            maxCompletionTokens,
            connection.Transport,
            connection.Name);
    }

    /// <summary>
    /// Looks at the last transcript entries to figure out which enabled agent
    /// should go next. If Agent 1 already spoke but Agent 2 hasn't, returns
    /// the index of Agent 2 so the round resumes from there.
    /// Returns 0 if a fresh round should start.
    /// </summary>
    private int ComputeResumeAgentIndex(RoomConfig room)
    {
        var enabledAgents = room.Agents.Where(a => a.IsEnabled && !a.IsTemporarilySuspended).ToList();
        if (enabledAgents.Count <= 1) return 0;

        var turns = ConvoState.SessionTurns;
        if (turns.Count == 0) return 0;

        // Walk backward through the transcript to find which agents spoke
        // in the current (incomplete) round. Stop at the first user message
        // or when we've seen more agent turns than there are agents.
        var spokenThisRound = new List<string>();
        for (int i = turns.Count - 1; i >= 0; i--)
        {
            var t = turns[i];
            if (t.Speaker == "You") break;
            if (enabledAgents.Any(a => a.Name == t.Speaker))
                spokenThisRound.Insert(0, t.Speaker);
            if (spokenThisRound.Count >= enabledAgents.Count) break;
        }

        if (spokenThisRound.Count == 0) return 0;
        if (spokenThisRound.Count >= enabledAgents.Count) return 0; // full round completed

        // Find the last agent who spoke, then return the next one's index
        var lastSpeaker = spokenThisRound[^1];
        var lastIdx = enabledAgents.FindIndex(a => a.Name == lastSpeaker);
        if (lastIdx < 0) return 0;

        var nextIdx = lastIdx + 1;
        return nextIdx < enabledAgents.Count ? nextIdx : 0;
    }

    private void OnConvoChanged() => InvokeAsync(StateHasChanged);

    // ─── Kokoro Test ───────────────────────────────────────────────

    private async Task TestKokoro()
    {
        _kokoroTesting = true;
        _kokoroTestResult = string.Empty;
        StateHasChanged();

        try
        {
            var s = AppState.Settings;
            var baseUrl = string.IsNullOrWhiteSpace(s.KokoroBaseUrl) ? "http://127.0.0.1:8880" : s.KokoroBaseUrl;
            var endpoint = baseUrl.TrimEnd('/') + "/v1/audio/speech";

            var payload = System.Text.Json.JsonSerializer.Serialize(new
            {
                model = string.IsNullOrWhiteSpace(s.KokoroModel) ? "kokoro" : s.KokoroModel,
                input = "Test.",
                voice = string.IsNullOrWhiteSpace(s.KokoroVoice) ? "af_heart" : s.KokoroVoice,
                response_format = "wav",
                speed = 1.0,
            });

            using var http = new HttpClient { Timeout = TimeSpan.FromSeconds(10) };
            using var request = new HttpRequestMessage(HttpMethod.Post, endpoint)
            {
                Content = new StringContent(payload, System.Text.Encoding.UTF8, "application/json"),
            };
            using var response = await http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                _kokoroTestOk = true;
                _kokoroTestResult = "Kokoro is running.";
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                _kokoroTestOk = false;
                _kokoroTestResult = $"Error {(int)response.StatusCode}: {Truncate(body, 120)}";
            }
        }
        catch (HttpRequestException)
        {
            _kokoroTestOk = false;
            _kokoroTestResult = "Cannot connect — Kokoro service is not running.";
        }
        catch (TaskCanceledException)
        {
            _kokoroTestOk = false;
            _kokoroTestResult = "Connection timed out — Kokoro may still be starting.";
        }
        catch (Exception ex)
        {
            _kokoroTestOk = false;
            _kokoroTestResult = $"Error: {Truncate(ex.Message, 120)}";
        }
        finally
        {
            _kokoroTesting = false;
            StateHasChanged();
        }
    }

    private void StartKokoroService()
    {
        try
        {
            var kokoroDir = Path.Combine(
                Environment.GetFolderPath(Environment.SpecialFolder.MyDocuments),
                "AgentGroupChat", "Kokoro-FastAPI");

            // Fallback: look relative to the app's base directory
            if (!Directory.Exists(kokoroDir))
            {
                var candidate = Path.GetFullPath(Path.Combine(AppContext.BaseDirectory, "..", "..", "..", "..", "..", "Kokoro-FastAPI"));
                if (Directory.Exists(candidate)) kokoroDir = candidate;
            }

            var scriptPath = Path.Combine(kokoroDir, "start-cpu.ps1");
            if (!File.Exists(scriptPath))
            {
                _kokoroTestOk = false;
                _kokoroTestResult = $"start-cpu.ps1 not found at {kokoroDir}";
                return;
            }

            var psi = new System.Diagnostics.ProcessStartInfo
            {
                FileName = "powershell",
                Arguments = $"-ExecutionPolicy Bypass -File \"{scriptPath}\"",
                WorkingDirectory = kokoroDir,
                UseShellExecute = true,
            };
            System.Diagnostics.Process.Start(psi);
            _kokoroTestOk = false;
            _kokoroTestResult = "Kokoro service starting in a new window — wait a moment then test again.";
        }
        catch (Exception ex)
        {
            _kokoroTestOk = false;
            _kokoroTestResult = $"Failed to start: {Truncate(ex.Message, 120)}";
        }
    }

    private static string Truncate(string text, int maxLength) =>
        text.Length <= maxLength ? text : text[..maxLength] + "...";

    // ─── TTS ───────────────────────────────────────────────────────

    private SpeechService.SpeechSettings BuildSpeechSettings()
    {
        var s = AppState.Settings;
        return new SpeechService.SpeechSettings(
            s.TtsEnabled, s.TtsProvider, s.TtsRate,
            s.KokoroBaseUrl, s.KokoroModel, s.KokoroVoice, s.KokoroLangCode, s.KokoroSpeed,
            s.PiperExePath, s.PiperModelsDir);
    }

    private async Task OnSpeechGateAsync(AgentConfig agent, string content, CancellationToken ct)
    {
        var settings = BuildSpeechSettings();
        if (!settings.Enabled) return;
        var voice = string.IsNullOrWhiteSpace(agent.TtsVoice) ? settings.KokoroVoice : agent.TtsVoice;
        await Speech.SpeakAsync(settings, content, voice, ct);
    }

    private async Task OnTtsToggled(bool enabled)
    {
        AppState.Settings.TtsEnabled = enabled;
        await AppState.SaveSettingsAsync();
    }

    private async Task OnTtsProviderChanged(string provider)
    {
        AppState.Settings.TtsProvider = provider;
        await AppState.SaveSettingsAsync();
        await RefreshVoices();
    }

    private async Task OnTtsRateChanged(int rate)
    {
        AppState.Settings.TtsRate = rate;
        await AppState.SaveSettingsAsync();
    }

    private async Task OnDefaultVoiceChanged(string voice)
    {
        AppState.Settings.KokoroVoice = voice;
        await AppState.SaveSettingsAsync();
    }

    private async Task OnUserVoiceChanged(string voice)
    {
        AppState.Settings.KokoroUserVoice = voice;
        await AppState.SaveSettingsAsync();
    }

    private async Task RefreshVoices()
    {
        if (!AppState.Settings.TtsProvider.Equals("Kokoro", StringComparison.OrdinalIgnoreCase))
        {
            _kokoroVoices.Clear();
            return;
        }
        var voices = await Speech.FetchKokoroVoicesAsync(AppState.Settings.KokoroBaseUrl);
        _kokoroVoices = voices.ToList();
        await InvokeAsync(StateHasChanged);
    }

    private async Task TestDefaultVoice()
    {
        if (_previewingVoice) return;
        _previewingVoice = true;
        StateHasChanged();
        try
        {
            var voice = AppState.Settings.KokoroVoice;
            var wav = await Speech.SynthesizePreviewAsync(AppState.Settings.KokoroBaseUrl, voice);
            if (wav is not null)
                await Speech.PlayPreviewAsync(wav, CancellationToken.None);
        }
        finally
        {
            _previewingVoice = false;
            StateHasChanged();
        }
    }

    private async Task TestUserVoice()
    {
        if (_previewingVoice) return;
        _previewingVoice = true;
        StateHasChanged();
        try
        {
            var voice = string.IsNullOrWhiteSpace(AppState.Settings.KokoroUserVoice)
                ? AppState.Settings.KokoroVoice
                : AppState.Settings.KokoroUserVoice;
            var wav = await Speech.SynthesizePreviewAsync(AppState.Settings.KokoroBaseUrl, voice);
            if (wav is not null)
                await Speech.PlayPreviewAsync(wav, CancellationToken.None);
        }
        finally
        {
            _previewingVoice = false;
            StateHasChanged();
        }
    }

    private async Task PlayFromMessage(int startIndex)
    {
        if (_isPlayingFrom) return;
        _isPlayingFrom = true;
        _playbackCts = new CancellationTokenSource();
        StateHasChanged();

        var settings = BuildSpeechSettings();
        var room = RoomState.SelectedRoom;
        var ct = _playbackCts.Token;

        try
        {
            // Narrate all existing messages from startIndex forward
            var messages = ConvoState.Messages;
            for (int i = startIndex; i < messages.Count; i++)
            {
                ct.ThrowIfCancellationRequested();
                var msg = messages[i];
                if (msg.IsSystem || string.IsNullOrWhiteSpace(msg.Content)) continue;

                var voice = settings.KokoroVoice;
                if (msg.IsUser && !string.IsNullOrWhiteSpace(AppState.Settings.KokoroUserVoice))
                {
                    voice = AppState.Settings.KokoroUserVoice;
                }
                else if (!msg.IsUser && room is not null)
                {
                    var agent = room.Agents.FirstOrDefault(a => a.Name == msg.Speaker);
                    if (agent is not null && !string.IsNullOrWhiteSpace(agent.TtsVoice))
                        voice = agent.TtsVoice;
                }

                ConvoState.SetStatus($"Speaking: {msg.Speaker}");
                StateHasChanged();
                await Speech.SpeakAsync(settings, msg.Content, voice, ct);
            }

            // After last message, kick off a new round so conversation continues
            if (room is not null && !ConvoState.IsRunning)
            {
                ConvoState.IsRunning = true;
                ConvoState.SetStatus("Running");
                _cts = new CancellationTokenSource();

                try
                {
                    await Runner.RunAsync(
                        room,
                        agent => ResolveSettings(agent),
                        ResolveSettings(null),
                        _iterations,
                        ConvoState.CompletedRounds,
                        _cts.Token);

                    ConvoState.CompletedRounds += _iterations;
                }
                catch (OperationCanceledException)
                {
                    ConvoState.AddSystemMessage("Stopped.");
                }
                catch (Exception ex)
                {
                    ConvoState.AddSystemMessage($"Error: {ex.Message}");
                }
                finally
                {
                    ConvoState.IsRunning = false;
                    ConvoState.SetStatus("Ready");
                    _cts?.Dispose();
                    _cts = null;
                }
            }
        }
        catch (OperationCanceledException)
        {
            ConvoState.SetStatus("Playback stopped.");
        }
        finally
        {
            _isPlayingFrom = false;
            _playbackCts?.Dispose();
            _playbackCts = null;
            StateHasChanged();
        }
    }

    private void TogglePause() => Speech.TogglePause();

    private void StopSpeech() => Speech.Stop();

    private void OnSpeechStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        ConvoState.OnChange -= OnConvoChanged;
        Runner.OnSystemMessage -= OnRunnerSystemMessage;
        Runner.OnAgentMessageStarted -= OnRunnerAgentStarted;
        Runner.OnAgentMessageCompleted -= OnRunnerAgentCompleted;
        Runner.OnStatusChanged -= OnRunnerStatusChanged;
        Runner.OnLog -= OnRunnerLog;
        Speech.OnPlaybackStateChanged -= OnSpeechStateChanged;
        Runner.OnSpeechGate = null;
        _cts?.Dispose();
        _playbackCts?.Dispose();
    }
}
