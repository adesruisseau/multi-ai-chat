@inherits LayoutComponentBase

@implements IDisposable
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<MudThemeProvider @ref="_themeProvider" Theme="_theme" IsDarkMode="_isDark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="2" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="() => _drawerOpen = !_drawerOpen" />
        <MudText Typo="Typo.h5" Class="ml-2">Agent Group Chat</MudText>
        <MudSpacer />
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mr-2">
            @if (_isAuthenticated)
            {
                <MudIcon Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit" Size="Size.Medium" />
                <MudText Typo="Typo.subtitle1">Hello, @username</MudText>
                <MudButton Variant="Variant.Text"
                           Color="Color.Inherit"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Logout"
                           OnClick="NavigateToLogout">
                    Logout
                </MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Text"
                           Color="Color.Inherit"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Login"
                           OnClick="NavigateToLogin">
                    Sign In
                </MudButton>
            }
        </MudStack>
        <MudSpacer />
        @if (_roomState.SelectedRoom is not null)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                     Class="mr-3">@_roomState.SelectedRoom.Name</MudChip>
        }
        <MudMenu Icon="@Icons.Material.Filled.Palette" Color="Color.Inherit" Dense="true"
                 AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
            @foreach (var a in _accents)
            {
                <MudMenuItem OnClick="@(() => SetAccent(a.Name))">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Circle" Style="@($"color:{a.Color}")" Size="Size.Small" />
                        <MudText>@a.Name</MudText>
                    </MudStack>
                </MudMenuItem>
            }
        </MudMenu>
        <MudToggleIconButton Toggled="_isDark"
                             Icon="@Icons.Material.Filled.DarkMode"
                             ToggledIcon="@Icons.Material.Filled.LightMode"
                             Color="Color.Inherit" ToggledColor="Color.Inherit"
                             ToggledChanged="OnDarkModeToggled" />
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="2" Variant="DrawerVariant.Mini"
               ClipMode="DrawerClipMode.Always" OpenMiniOnHover="true">
        <MudNavMenu>
            <MudNavLink Href="/" Match="NavLinkMatch.All"
                        Icon="@Icons.Material.Filled.RocketLaunch">Setup Guide</MudNavLink>
            <MudNavLink Href="/rooms" Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Filled.MeetingRoom">Rooms</MudNavLink>
            <MudNavLink Href="/chat" Match="NavLinkMatch.All"
                        Icon="@Icons.Material.Filled.Chat">Chat</MudNavLink>
            <MudNavLink Href="/logs" Match="NavLinkMatch.All"
                        Icon="@Icons.Material.Filled.List">Memory & Logs</MudNavLink>
            <MudNavLink Href="/prompts" Match="NavLinkMatch.All"
                        Icon="@Icons.Material.Filled.LibraryBooks">Prompt Library</MudNavLink>
            <MudNavLink Href="/models" Match="NavLinkMatch.All"
                        Icon="@Icons.Material.Filled.Memory">AI Models</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        
        <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="my-4 px-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    [Inject] RoomState _roomState { get; set; } = default!;
    [Inject] AppState _appState { get; set; } = default!;
    
    private MudThemeProvider _themeProvider = default!;
    private MudTheme _theme = AppTheme.Build();
    private bool _isDark;
    private bool _drawerOpen = true;
    private string _currentAccent = "Terracotta";

    private static readonly (string Name, string Color)[] _accents =
    [
        ("Terracotta", "#D96C54"),
        ("Ocean", "#3E84C6"),
        ("Berry", "#C05B86"),
        ("Forest", "#4E8A63"),
        ("Gold", "#B88322"),
    ];

    private string? username;
    private bool _isAuthenticated;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        _isAuthenticated = state.User.Identity?.IsAuthenticated == true;
        username = state.User.Identity?.Name;


        _roomState.OnChange += StateHasChanged;
        _appState.OnChange += OnAppStateChanged;

        if (_appState.IsLoaded)
        {
            ApplyFromSettings();
        }
        else
        {
            await _appState.LoadAsync();
            ApplyFromSettings();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _appState.Settings.UiTheme == "System")
        {
            _isDark = await _themeProvider.GetSystemDarkModeAsync();
            StateHasChanged();
        }
    }

    private void ApplyFromSettings()
    {
        _currentAccent = _appState.Settings.UiAccent;
        _isDark = _appState.Settings.UiTheme switch
        {
            "Dark" => true,
            "Light" => false,
            _ => _isDark, // keep System preference
        };
        _theme = AppTheme.Build(_currentAccent);
    }

    private async Task SetAccent(string accent)
    {
        _currentAccent = accent;
        _theme = AppTheme.Build(accent);
        _appState.Settings.UiAccent = accent;
        await _appState.SaveSettingsAsync();
    }

    private async Task OnDarkModeToggled(bool toggled)
    {
        _isDark = toggled;
        _appState.Settings.UiTheme = toggled ? "Dark" : "Light";
        await _appState.SaveSettingsAsync();
    }

    private void NavigateToLogin() => NavigationManager.NavigateTo("/login", forceLoad: true);

    private void NavigateToLogout() => NavigationManager.NavigateTo("/logout", forceLoad: true);

    private void OnAppStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        _roomState.OnChange -= StateHasChanged;
        _appState.OnChange -= OnAppStateChanged;
    }
}
