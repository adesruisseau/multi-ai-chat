@page "/chat"
@inject RoomState RoomState
@inject AppState AppState
@inject ConversationState ConvoState
@inject AgentGroupChat.Core.Services.ConversationRunner Runner
@inject AgentGroupChat.Core.Services.Interfaces.IMemoryRepository MemoryRepo
@inject AgentGroupChat.Core.Services.Interfaces.ITranscriptRepository TranscriptRepo
@inject AgentGroupChat.Core.Services.Interfaces.ISceneArchiveRepository SceneArchiveRepo
@inject AgentGroupChat.Core.Services.SpeechService Speech
@inject AgentGroupChat.Core.Services.LogService LogService
@inject AgentGroupChat.Core.Services.ImageClient ImageClient
@inject AgentGroupChat.Core.Services.RoomTurnPolicyService TurnPolicyService
@using System.Security.Claims
@using AgentGroupChat.Core.Models.Domain
@using AgentGroupChat.Core.Services
@using AgentGroupChat.UI.Shared.Theming
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using AgentGroupChat.Core.Realtime
@inject AgentGroupChat.Core.Realtime.IChatLiveUpdateNotifier ChatLiveUpdates
@inject AgentGroupChat.Core.Realtime.ChatRealtimeService chatService
@inject AuthenticationStateProvider AuthStateProvider

@implements IDisposable
@attribute [Authorize]

<MudGrid Justify="Justify.Center">
    <MudItem xs="10" sm="12">
        <MudText Typo="Typo.h4" GutterBottom="true">Chat</MudText>
            <MudPaper Class="pa-4 mb-4" Elevation="1">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudSelect @bind-Value="_selectedRoomId" Label="Room" Class="flex-grow-1" T="string">
                        @foreach (var room in RoomState.Rooms)
                        {
                            <MudSelectItem T="string" Value="@room.Id">@room.Name</MudSelectItem>
                        }
                    </MudSelect>
                    <MudButton OnClick="LoadRoom" Variant="Variant.Outlined">Load</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Warning" OnClick="ClearRoom" Disabled="ConvoState.IsRunning">Clear Room</MudButton>
                </MudStack>
            </MudPaper>
    </MudItem>
@if (RoomState.SelectedRoom is null)
{
    <MudItem xs="10" sm="12">
        <MudAlert Severity="Severity.Info">Select a room above and click Load to start chatting.</MudAlert>
    </MudItem>
}
else
{
    <MudItem xs="8" sm="9">
        <div>
            <MudPaper Class="pa-4 mb-4" Elevation="1">
                <MudText Typo="Typo.h5">Chat</MudText>
                    <div @ref="_chatDiv" style="overflow-y:auto; height: 600px">
                        @{ var isDark = AppState.Settings.UiTheme == "Dark"; }
                        @{ var visibleMessages = ConvoState.Messages.Where(m => !m.IsSystem).ToList(); }
                        @for (int i = 0; i < visibleMessages.Count; i++)
                        {
                            var msg = visibleMessages[i];
                            var idx = ConvoState.Messages.IndexOf(msg);
                            var borderColor = AgentColorPresets.FindByName(msg.ColorTheme, isDark).AccentHex;
                            var bgColor = AgentColorPresets.FindByName(msg.ColorTheme, isDark).BackgroundHex;
                            <MudPaper Class="pa-2 mb-2" Elevation="0" Outlined="true"
                                      Style="@($"border-left: 4px solid {borderColor}; background: {bgColor}")">
                                <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="1">
                                    <div style="flex:1; min-width:0;">
                                        <MudText Typo="Typo.subtitle2" Style="@($"color:{borderColor}")">@msg.Speaker</MudText>
                                        @if (msg.Speaker == "Image")
                                        {
                                            <img src="@msg.Content" alt="Generated test preview" style="max-width:100%;max-height:420px;border-radius:8px;display:block;" />
                                        }
                                        else {
                                        <MudText Typo="Typo.body2" Style="white-space: pre-wrap">@msg.Content</MudText>
                                        }
                                    </div>
                                    <MudIconButton Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small"
                                                   OnClick="@(() => PlayFromMessage(idx))" Disabled="_isPlayingFrom"
                                                   Title="Play from here" />
                                </MudStack>
                            </MudPaper>
                        }
                </div>
            </MudPaper>
        </div>

    <MudPaper Class="pa-4 mb-4" Elevation="1">
        @if (!_generatingImage)
        {
            <MudTextField @bind-Value="_userInput" Label="@WhosMessage" Class="mb-3" OnKeyDown="OnKeyDown" Lines="8" Disabled="@(ConvoState.IsRunning || InputLocked)"
                          Immediate="true" />
        }
        else
        {
            <MudTextField @bind-Value="imagePrompt" Label="Generate Image" Class="mb-3" OnKeyDown="OnKeyDown" Lines="8"
                          Immediate="true" />
        }
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudNumericField @bind-Value="_iterations" Label="Rounds" Min="1" Style="max-width:100px" />
            <MudSpacer />
            @if (RoomState.SelectedRoom.EnableSceneImageGeneration && !String.IsNullOrWhiteSpace(RoomState.SelectedRoom.SceneImageModelId))
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="GenerateImagePromptAsync" Disabled="ConvoState.IsRunning && !_generatingImage">Generate Image Prompt</MudButton>
            }
            @if (_generatingImage)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GenerateImageAsync">Generate</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="CancelGenerateImageAsync">Cancel</MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Run" Disabled="@(ConvoState.IsRunning || RunLocked)">Run</MudButton>
                @* <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="Stop" Disabled="!ConvoState.IsRunning">Stop</MudButton> *@
            }
            
        </MudStack>
        <MudText Typo="Typo.caption" Class="mt-1">@ConvoState.Status</MudText>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudText Typo="Typo.caption">@GetSpeechSummary()</MudText>
            <MudStack Spacing="0" Style="min-width:160px">
                <MudText Typo="Typo.caption">Rate: @AppState.Settings.TtsRate</MudText>
                <MudSlider Value="AppState.Settings.TtsRate" Min="-5" Max="5" Step="1" T="int"
                           ValueChanged="OnTtsRateChanged" Color="Color.Primary" />
            </MudStack>
            <MudSpacer />
            @if (Speech.IsSpeaking)
            {
                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="TogglePause">
                    @(Speech.IsPaused ? "Resume" : "Pause")
                </MudButton>
            }
        </MudStack>
        <MudText Typo="Typo.caption" Class="mt-2">
            Speech enablement, provider choice, room fallback voice, and your voice now live under Rooms > Room Settings.
        </MudText>
    </MudPaper>
    </MudItem>
    <MudItem xs="2" sm="3">
        @if (RoomState.SelectedRoom is not null && RoomState.SelectedRoom.DataTrackers.Where(x => x.Enabled).Count() > 0)
        {
                <MudPaper Class="pa-4 mb-4" Elevation="1">
                    <div>
                        <MudGrid Justify="Justify.Center">
                            <MudItem xs="10">
                                <MudText Typo="Typo.h5">Trackers</MudText>
                            </MudItem>
                            @foreach (var tracker in RoomState.SelectedRoom.DataTrackers)
                            {
                                <MudItem xs="10">
                                    <MudText Typo="Typo.h6">@tracker.DataKey</MudText>
                                </MudItem>
                                <MudItem xs="10">
                                    @if (tracker.ValueType == "int" || tracker.ValueType == "decimal")
                                    {
                                        <div style="width:100%">
                                            <MudProgressLinear Color="Color.Primary"
                                                               Style="height: 20px"
                                                               Value="@double.Parse(tracker.Value)"
                                                               Min="@tracker.MinValue.Value"
                                                               Max="@tracker.MaxValue.Value" />

                                            <MudText Typo="Typo.caption">
                                                Current: @tracker.Value / @tracker.MaxValue
                                            </MudText>
                                        </div>
                                    }
                                    else
                                    {
                                        <MudText>@tracker.Value</MudText>
                                    }
                                </MudItem>
                                <MudItem xs="10">
                                    <MudText Typo="Typo.body2">@tracker.PromptText</MudText>
                                </MudItem>
                            }
                        </MudGrid>
                    </div>
                    <br />
            </MudPaper>
        }
    </MudItem>
}
    
</MudGrid>

@code {
    private string _selectedRoomId = string.Empty;
    private string _userInput = string.Empty;
    private int _iterations = 1;
    private CancellationTokenSource? _cts;
    private CancellationTokenSource? _playbackCts;
    private bool _isPlayingFrom;
    private ElementReference _chatDiv;
    [Inject]
    private IJSRuntime JS { get; set; } = default!;
    private int _lastMessageCount;
    private string WhosMessage = "Message";
    private bool isNotRoomOwner = false;
    public string accessingUserId = "";
    public ClaimsPrincipal user;
    private RoomTurnPolicy _turnPolicy = new();
    private IDisposable? _chatLiveSubscription;

    private bool InputLocked => !_turnPolicy.CanSendMessage;

    private bool RunLocked => _turnPolicy.RequiresHumanMessage
        ? !_turnPolicy.CanSendMessage || string.IsNullOrWhiteSpace(_userInput)
        : !_turnPolicy.CanContinueRun;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await Task.Delay(100);
        if (ConvoState.Messages.Count != _lastMessageCount)
        {
            try 
            {
                _lastMessageCount = ConvoState.Messages.Count;
                await JS.InvokeVoidAsync("scrollToBottom", _chatDiv);
            }
            catch
            {
                await LogService.LogAsync(RoomState.SelectedRoom.Id, LogCategory.System, "Focus Chat JS", "An error occurred while trying to focus the chat window.");
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        AppState.OnChange += OnAppStateChanged;
        ConvoState.OnChange += OnConvoChanged;
        Runner.OnSystemMessage += OnRunnerSystemMessage;
        Runner.OnAgentMessageStarted += OnRunnerAgentStarted;
        Runner.OnAgentMessageCompleted += OnRunnerAgentCompleted;
        Runner.OnStatusChanged += OnRunnerStatusChanged;
        Runner.OnLog += OnRunnerLog;
        Speech.OnPlaybackStateChanged += OnSpeechStateChanged;

        if (RoomState.Rooms.Count == 0)
            await RoomState.LoadAsync();

        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        user = state.User;
        accessingUserId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        isNotRoomOwner = RoomState.SelectedRoom?.UserId != accessingUserId;

        if (RoomState.SelectedRoom is not null)
        {
            _selectedRoomId = RoomState.SelectedRoom.Id;
            await LoadRoom();
        }
        else if (RoomState.Rooms.Count > 0)
        {
            _selectedRoomId = RoomState.Rooms[0].Id;
        }
        SubscribeToChatLiveUpdates(_selectedRoomId);
        RefreshTurnPolicy();
    }

    private void SubscribeToChatLiveUpdates(string? roomId)
    {
        _chatLiveSubscription?.Dispose();
        _chatLiveSubscription = null;

        if (string.IsNullOrWhiteSpace(roomId))
            return;

        _chatLiveSubscription = ChatLiveUpdates.Subscribe(roomId, HandleChatLiveUpdatesAsync);
    }

    private Task HandleChatLiveUpdatesAsync(ChatLiveEvent update)
    {
        return InvokeAsync(async () =>
        {
            switch (update.Kind)
            {
                case ChatLiveEventKinds.NewMessage:
                case ChatLiveEventKinds.ChatCleared:
                    {
                        var selectedRoomId = update.RoomId;

                        await LoadRoom();
                        break;
                    }
                default:
                    break;
            }
        });
    }

    private void UpdateSelectedRoom()
    {
        accessingUserId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        isNotRoomOwner = RoomState.SelectedRoom?.UserId != accessingUserId;
        RefreshTurnPolicy();
        StateHasChanged();
    }

    private void OnRunnerSystemMessage(string msg)
    {
        // System messages are tracked internally but not shown in chat
        ConvoState.SetStatus(msg);
        _ = LogService.LogAsync(RoomState.SelectedRoom.Id, LogCategory.System, "Runner", msg);
        InvokeAsync(StateHasChanged);
    }

    private void OnRunnerAgentStarted(AgentConfig agent, string msg)
    {
        ConvoState.AddAgentMessage(agent, msg);
        InvokeAsync(StateHasChanged);
    }

    private void OnRunnerAgentCompleted(AgentConfig agent, string msg)
    {
        ConvoState.CompleteAgentMessage(agent, msg);
        InvokeAsync(StateHasChanged);
    }

    private void OnRunnerStatusChanged(string status)
    {
        ConvoState.SetStatus(status);
        InvokeAsync(StateHasChanged);
    }

    private void OnRunnerLog(string message)
    {
        // Determine category from message content
        var category = message.Contains("memory", StringComparison.OrdinalIgnoreCase)
            ? LogCategory.Memory
            : LogCategory.Response;
        _ = LogService.LogAsync(RoomState.SelectedRoom.Id, category, "Runner", message);
    }

    private async Task LoadRoom()
    {
        var room = RoomState.Rooms.FirstOrDefault(r => r.Id == _selectedRoomId);
        if (room is null) return;
        RoomState.SelectRoom(room);
        ConvoState.Clear();


        var turns = await TranscriptRepo.GetAsync(room.Id);
        foreach (var turn in turns)
        {
            var humanParticipant = room.Agents.FirstOrDefault(agent =>
                agent.IsHumanParticipant && string.Equals(agent.Name, turn.Speaker, StringComparison.OrdinalIgnoreCase));
            var isHuman = humanParticipant is not null || turn.Speaker == Core.SpeakerNames.DefaultHuman;
            if (isHuman)
            {
                ConvoState.Messages.Add(new ChatMessage
                {
                    Speaker = turn.Speaker,
                    Content = turn.Content,
                    IsUser = true,
                    ColorTheme = humanParticipant?.ColorTheme ?? AgentColorPresets.FindByName(AppState.Settings.UiAccent, AppState.Settings.UiTheme != "Light").Name ?? "Terracotta"

                });
            }
            else
            {
                var agent = room.Agents.FirstOrDefault(a => a.Name == turn.Speaker);
                ConvoState.Messages.Add(new ChatMessage
                {
                    Speaker = turn.Speaker,
                    Content = turn.Content,
                    ColorTheme = agent?.ColorTheme ?? "Terracotta"
                });
            }
            ConvoState.SessionTurns.Add(turn);
        }
        ConvoState.NotifyChanged();
        RefreshTurnPolicy();
    }

    private async Task Run()
    {

        if (RoomState.SelectedRoom is null) return;
        if (ConvoState.IsRunning) return;
        var room = RoomState.SelectedRoom;
        RefreshTurnPolicy();

        if (_turnPolicy.RequiresHumanMessage)
        {
            if (!_turnPolicy.CanSendMessage)
            {
                ConvoState.SetStatus(_turnPolicy.WaitingMessage);
                return;
            }

            if (string.IsNullOrWhiteSpace(_userInput))
            {
                ConvoState.SetStatus(_turnPolicy.WaitingMessage);
                return;
            }
        }
        else if (!_turnPolicy.CanContinueRun)
        {
            ConvoState.SetStatus(_turnPolicy.WaitingMessage);
            return;
        }

        ConvoState.IsRunning = true;

        if (!string.IsNullOrWhiteSpace(_userInput))
        {
            var speaker = ResolveHumanSpeaker(room);
            ConvoState.AddUserMessage(_userInput, speaker.Name, speaker.ColorTheme);
            
            //await TranscriptRepo.AppendAsync
            await chatService.UpdateAsync(new TranscriptTurn
            {
                RoomId = room.Id,
                Speaker = speaker.Name,
                Content = _userInput,
                ColorTheme = speaker.ColorTheme
            });
            var userTextToNarrate = _userInput;
            _userInput = string.Empty;
            // Narrate user message before agents start
            var ttsSettings = BuildSpeechSettings(room);
            if (ttsSettings.Enabled)
            {
                var voice = !string.IsNullOrWhiteSpace(speaker.TtsVoice)
                    ? speaker.TtsVoice
                    : RoomSpeechResolver.GetUserVoice(room, AppState.Settings);
                await Speech.SpeakAsync(ttsSettings, userTextToNarrate, voice, CancellationToken.None);
            }


        }

        // Clean up any stale thinking placeholders from a previous failed run
        ConvoState.RemoveThinkingPlaceholders();


        ConvoState.SetStatus("Running");
        _cts = new CancellationTokenSource();

        try
        {
            var completedRounds = await Runner.RunAsync(
                room,
                _iterations,
                ConvoState.CompletedRounds,
                _cts.Token);

            ConvoState.CompletedRounds += completedRounds;
        }
        catch (OperationCanceledException)
        {
            ConvoState.AddSystemMessage("Stopped.");
            _ = LogService.LogAsync(RoomState.SelectedRoom.Id, LogCategory.System, "Runner", "Run cancelled by user.");
        }
        catch (Exception ex)
        {
            ConvoState.AddSystemMessage($"Error: {ex.Message}");
            _ = LogService.LogAsync(RoomState.SelectedRoom.Id, LogCategory.System, "Runner", $"Run failed: {ex.GetType().Name}", ex.Message);
        }
        finally
        {
            // Clean up any leftover thinking placeholders from failed/cancelled turns
            ConvoState.RemoveThinkingPlaceholders();
            ConvoState.IsRunning = false;
            ConvoState.SetStatus("Ready");
            RefreshTurnPolicy();
            ConvoState.NotifyChanged();
            _cts?.Dispose();
            _cts = null;
        }
    }

    private void Stop()
    {
        _cts?.Cancel();
        _playbackCts?.Cancel();
        Speech.Stop();
    }

    private async Task ClearRoom()
    {
        if (RoomState.SelectedRoom is null) return;
        await TranscriptRepo.ClearAsync(RoomState.SelectedRoom.Id);
        await MemoryRepo.ClearAllForRoomAsync(RoomState.SelectedRoom.Id);
        await SceneArchiveRepo.DeleteAllForRoomAsync(RoomState.SelectedRoom.Id);
        await LogService.ClearAsync(RoomState.SelectedRoom.Id);
        ConvoState.Clear();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey && !ConvoState.IsRunning)
        {
            await Task.Yield();
            await Run();
        }
    }


    private void OnAppStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnConvoChanged()
    {
        RefreshTurnPolicy();
        InvokeAsync(StateHasChanged);
    }

    private SpeechService.SpeechSettings BuildSpeechSettings(RoomConfig? room = null) =>
        RoomSpeechResolver.BuildSettings(room ?? RoomState.SelectedRoom, AppState.Settings);

    private async Task OnTtsRateChanged(int rate)
    {
        AppState.Settings.TtsRate = rate;
        await AppState.SaveSettingsAsync();
    }

    private async Task PlayFromMessage(int startIndex)
    {
        if (_isPlayingFrom) return;
        _isPlayingFrom = true;
        _playbackCts = new CancellationTokenSource();
        StateHasChanged();

        var settings = BuildSpeechSettings();
        var room = RoomState.SelectedRoom;
        var ct = _playbackCts.Token;

        try
        {
            if (!settings.Enabled)
            {
                ConvoState.SetStatus("Speech is disabled for this room.");
                return;
            }

            // Narrate all existing messages from startIndex forward
            var messages = ConvoState.Messages;
            for (int i = startIndex; i < messages.Count; i++)
            {
                ct.ThrowIfCancellationRequested();
                var msg = messages[i];
                if (msg.IsSystem || string.IsNullOrWhiteSpace(msg.Content)) continue;

                var voice = RoomSpeechResolver.GetFallbackVoice(room, AppState.Settings);
                if (msg.IsUser)
                {
                    voice = RoomSpeechResolver.GetUserVoice(room, AppState.Settings);
                }
                else if (!msg.IsUser && room is not null)
                {
                    var agent = room.Agents.FirstOrDefault(a => a.Name == msg.Speaker);
                    if (agent is not null && !string.IsNullOrWhiteSpace(agent.TtsVoice))
                        voice = agent.TtsVoice;
                }

                ConvoState.SetStatus($"Speaking: {msg.Speaker}");
                StateHasChanged();
                await Speech.SpeakAsync(settings, msg.Content, voice, ct);
            }

            // After last message, kick off a new round so conversation continues
            if (room is not null && !ConvoState.IsRunning)
            {
                await Run();
            }
        }
        catch (OperationCanceledException)
        {
            ConvoState.SetStatus("Playback stopped.");
        }
        finally
        {
            _isPlayingFrom = false;
            _playbackCts?.Dispose();
            _playbackCts = null;
            StateHasChanged();
        }
    }
    private string _imagePreviewDataUrl = string.Empty;
    private bool _generatingImage = false;
    private ImageConnection imageConnection;
    private ImageModel imageModel;
    private string imagePrompt;
    private async Task GenerateImagePromptAsync()
    {
        _generatingImage = true;
        imageModel = AppState.ImageModels.Where(x => x.Id == RoomState.SelectedRoom.SceneImageModelId).First();
        if (imageModel is null)
        {
            await LogService.LogAsync(RoomState.SelectedRoom.Id, LogCategory.System, "Image Generation", "The model was not retrieved during the image generation process.");
            _generatingImage = false;
            return;

        }
        imageConnection = AppState.ImageConnections.Where(x => x.Id == imageModel.ConnectionId).First();
        if (imageConnection is null)
        {
            await LogService.LogAsync(RoomState.SelectedRoom.Id, LogCategory.System, "Image Generation", "The connection was not retrieved during the image generation process.");
            _generatingImage = false;
            return;

        }
        imagePrompt = "";
        imagePrompt += RoomState.SelectedRoom!.SceneImageStyleNotes;
        if (RoomState.SelectedRoom.UseCreativeImageGeneration)
        {
            RoomState.SelectedRoom.Agents.ForEach(x =>
            {
                if (!String.IsNullOrWhiteSpace(x.AppearanceSummary) && !x.IsTemporarilySuspended && x.IsEnabled)
                {
                    imagePrompt += $"\r\nInclude character: {x.Name} description: {x.AppearanceSummary}";
                }
            });

            string narrativeText = ConvoState.Messages.Where(x => x.Speaker.Trim().ToUpper().Equals("DM") || x.Speaker.Trim().ToUpper().Equals("NARRATOR")).Last().Content;
            imagePrompt += $"\r\nLast Narrative Text: {narrativeText}";
        }

        string currentRoomStateActions = await MemoryRepo.GetAsync(RoomState.SelectedRoom.Id, null, MemoryKind.SharedRoom);
        imagePrompt += $"\r\nCurrent Room Information: {currentRoomStateActions}";
    }

    private async Task GenerateImageAsync()
    {
        try
        {
            var imageResult = await ImageClient.GenerateTestImageAsync(imageConnection, imageModel, imagePrompt, CancellationToken.None);
            TranscriptTurn turn = new TranscriptTurn();
            turn.Speaker = "Image";
            turn.Content = $"data:{imageResult.MimeType};base64,{Convert.ToBase64String(imageResult.ImageBytes)}";
            var isDark = AppState.Settings.UiTheme == "Dark";
            turn.ColorTheme = AgentColorPresets.FindByName(AppState.Settings.UiAccent, isDark).Name ?? "Terracotta";
            turn.CreatedAt = DateTimeOffset.Now;
            turn.RoomId = RoomState.SelectedRoom.Id;
            turn.Round = ConvoState.CompletedRounds;

            _imagePreviewDataUrl = $"data:{imageResult.MimeType};base64,{Convert.ToBase64String(imageResult.ImageBytes)}";

            await chatService.UpdateAsync(turn);
            //await TranscriptRepo.AppendAsync(turn);
        }
        catch (Exception ex)
        {
            await LogService.LogAsync(RoomState.SelectedRoom.Id, LogCategory.System, "Image Generation Failure", "The image failed to return", ex.Message);
            _imagePreviewDataUrl = string.Empty;

        }
        _generatingImage = false;
        StateHasChanged();
    }

    private void CancelGenerateImageAsync()
    {
        _generatingImage = false;
    }

    private string GetSpeechSummary()
    {
        var room = RoomState.SelectedRoom;
        var enabled = RoomSpeechResolver.IsSpeechEnabled(room, AppState.Settings);
        var provider = RoomSpeechResolver.GetProvider(room, AppState.Settings);
        return enabled ? $"Speech: {provider}" : "Speech: Off";
    }

    private void TogglePause() => Speech.TogglePause();

    private void OnSpeechStateChanged() => InvokeAsync(StateHasChanged);

    private void RefreshTurnPolicy()
    {
        if (RoomState.SelectedRoom is null)
        {
            _turnPolicy = new RoomTurnPolicy();
            WhosMessage = "Message";
            return;
        }

        _turnPolicy = TurnPolicyService.Evaluate(RoomState.SelectedRoom, ConvoState.SessionTurns, accessingUserId);
        WhosMessage = _turnPolicy.InputLabel;
    }

    private HumanSpeaker ResolveHumanSpeaker(RoomConfig room)
    {
        if (!string.IsNullOrWhiteSpace(_turnPolicy.ExpectedHumanParticipantId))
        {
            var participant = room.Agents.FirstOrDefault(agent => agent.Id == _turnPolicy.ExpectedHumanParticipantId);
            if (participant is not null)
            {
                return new HumanSpeaker(participant.Name, participant.TtsVoice, participant.ColorTheme);
            }
        }

        return _defaultSpeaker;
    }

    private record HumanSpeaker(string Name, string TtsVoice, string ColorTheme);

    private static readonly HumanSpeaker _defaultSpeaker = new(Core.SpeakerNames.DefaultHuman, "", "");

    public void Dispose()
    {
        ConvoState.OnChange -= OnConvoChanged;
        Runner.OnSystemMessage -= OnRunnerSystemMessage;
        Runner.OnAgentMessageStarted -= OnRunnerAgentStarted;
        Runner.OnAgentMessageCompleted -= OnRunnerAgentCompleted;
        Runner.OnStatusChanged -= OnRunnerStatusChanged;
        Runner.OnLog -= OnRunnerLog;
        Speech.OnPlaybackStateChanged -= OnSpeechStateChanged;
        _chatLiveSubscription?.Dispose();
        _cts?.Dispose();
        _playbackCts?.Dispose();
    }
}

<script>
        window.scrollToBottom = (element) => {
        element.scrollTop = element.scrollHeight;
    };

</script>