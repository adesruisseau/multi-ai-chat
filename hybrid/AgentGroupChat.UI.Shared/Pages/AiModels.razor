@page "/models"
@inject AgentGroupChat.UI.Shared.State.AppState AppState
@inject AgentGroupChat.Core.Services.LlmClient LlmClient
@inject AgentGroupChat.Core.Services.ImageClient ImageClient
@using AgentGroupChat.Core.Models.Llm
@using static AgentGroupChat.Core.LlmTransports
@using static AgentGroupChat.Core.ImageTransports

@attribute [Authorize]

<MudGrid Justify="Justify.Center">
    <MudItem xs="8" >
        <MudText Typo="Typo.h4" GutterBottom="true">AI Models</MudText>

        <MudTabs Rounded="true">
            <MudTabPanel Text="Text">
                <MudGrid>
                    <MudItem xs="12">
                        <MudPaper Class="pa-4 mb-4" Elevation="1">
                            <MudText Typo="Typo.h6">AI Connections</MudText>
                            <MudText Typo="Typo.body2" Class="mb-2">Configure endpoints for your text AI providers.</MudText>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mb-3" OnClick="AddConnection">Add Connection</MudButton>

                            @foreach (var conn in AppState.Connections)
                            {
                                <MudPaper Class="pa-3 mb-3" Elevation="0" Outlined="true">
                                    <MudGrid>
                                        <MudItem xs="3">
                                            <MudTextField @bind-Value="conn.Name" Label="Name" />
                                        </MudItem>
                                        <MudItem xs="3">
                                            <MudSelect @bind-Value="conn.Transport" Label="Transport" T="string">
                                                <MudSelectItem T="string" Value='@(OpenAiCompatible)'>OpenAI Compatible</MudSelectItem>
                                                <MudSelectItem T="string" Value='@(Groq)'>Groq</MudSelectItem>
                                                <MudSelectItem T="string" Value='@(Gemini)'>Gemini</MudSelectItem>
                                                <MudSelectItem T="string" Value='@(HuggingFace)'>HuggingFace</MudSelectItem>
                                                <MudSelectItem T="string" Value='@(Ollama)'>Ollama</MudSelectItem>
                                            </MudSelect>
                                        </MudItem>
                                        <MudItem xs="3">
                                            <MudTextField @bind-Value="conn.Endpoint" Label="Endpoint" />
                                        </MudItem>
                                        <MudItem xs="3">
                                            <MudTextField @bind-Value="conn.ApiKey" Label="API Key" InputType="InputType.Password" />
                                        </MudItem>
                                        <MudItem xs="12">
                                            <MudStack Row="true" Spacing="2">
                                                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => SaveConnection(conn)">Save</MudButton>
                                                <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="() => DeleteConnection(conn.Id)">Delete</MudButton>
                                            </MudStack>
                                        </MudItem>
                                    </MudGrid>
                                </MudPaper>
                            }
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12">
                        <MudPaper Class="pa-4" Elevation="1">
                            <MudText Typo="Typo.h6">Model Catalog</MudText>
                            <MudText Typo="Typo.body2" Class="mb-2">Register models that agents and the summarizer can use.</MudText>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mb-3" OnClick="AddModel">Add Model</MudButton>

                            @if (!string.IsNullOrEmpty(_testResult))
                            {
                                <MudAlert Severity="@_testSeverity" Class="mb-3" ShowCloseIcon="true" CloseIconClicked="ClearTextTestResult">
                                    @_testResult
                                </MudAlert>
                            }
                            <MudExpansionPanels>
                                @foreach (var model in AppState.Models)
                                {
                                    <MudExpansionPanel Text="@model.Name">
                                        <MudGrid>
                                            <!--Name | Conn-->
                                            <MudItem xs="6">
                                                <MudTextField @bind-Value="model.Name" Label="Name"/>
                                                <MudText Typo="Typo.body1">Generic name you will see instead of the model Id on other pages.</MudText>
                                            </MudItem>
                                            <MudItem xs="6">
                                                <MudSelect @bind-Value="model.ConnectionId" T="string" Label="Connection">
                                                    @foreach (var conn in AppState.Connections)
                                                    {
                                                        <MudSelectItem T="string" Value="@conn.Id">@conn.Name</MudSelectItem>
                                                    }
                                                </MudSelect>
                                            </MudItem>
                                            <!--ModelId | Notes-->
                                            <MudItem xs="6">
                                                <MudTextField @bind-Value="model.ModelId" Label="Model Id" />
                                                <MudText Typo="Typo.body1">Exact ModelId for the AI service.</MudText>
                                            </MudItem>
                                            <MudItem xs="6">
                                                <MudTextField @bind-Value="model.Notes" Label="Notes" />
                                            </MudItem>
                                            <!--Temperature | MaxTokens-->
                                            <MudItem xs="6">
                                                <MudNumericField Min="0.0M" Max="1.0M" T="decimal" Step=".1M" @bind-Value="model.Temperature" Label="Temperature" />
                                                <MudText Typo="Typo.body1">Lower temperature makes models behave more deterministically. <br />
                                                    Higher temperature makes them more creative and random. <br />
                                                    Start with 0.7 and fine-tune.</MudText>
                                            </MudItem>
                                            <MudItem xs="6">
                                                <MudNumericField Min="0" Max="32000" T="int" Step="8" @bind-Value="model.MaxTokens" Label="Max Tokens" />
                                                <MudText Typo="Typo.body1">
                                                    Force the model to a max token usage.<br />
                                                    Low values may cut off message completion<br />
                                                    High values may exhaust token quotas faster.
                                                </MudText>
                                            </MudItem>
                                            <!-- Save | Test | Delete-->
                                            <MudItem xs="2">
                                                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => SaveModel(model)">Save</MudButton>
                                            </MudItem>
                                            <MudItem xs="2">
                                                <MudButton Variant="Variant.Outlined"Color="Color.Primary" OnClick="() => TestModel(model)" Disabled="_isTesting">Test</MudButton>
                                            </MudItem>
                                            <MudItem xs="2">
                                                <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="() => DeleteModel(model.Id)">Delete</MudButton>
                                            </MudItem>
                                            <MudItem xs="6">
                                                <MudText>&nbsp;</MudText>
                                            </MudItem>
                                        </MudGrid>
                                    </MudExpansionPanel>
                                }
                            </MudExpansionPanels>
                            @* <MudTable Items="AppState.Models" Dense="true" Hover="true">
                                <HeaderContent>
                                    <MudTh>Name</MudTh>
                                    <MudTh>Connection</MudTh>
                                    <MudTh>Model ID</MudTh>
                                    <MudTh>Notes</MudTh>
                                    <MudTh>Actions</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd><MudTextField @bind-Value="context.Name" /></MudTd>
                                    <MudTd>
                                        <MudSelect @bind-Value="context.ConnectionId" T="string">
                                            @foreach (var conn in AppState.Connections)
                                            {
                                                <MudSelectItem T="string" Value="@conn.Id">@conn.Name</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudTd>
                                    <MudTd><MudTextField @bind-Value="context.ModelId" /></MudTd>
                                    <MudTd><MudTextField @bind-Value="context.Notes" /></MudTd>
                                    <MudTd>
                                        <MudStack Row="true" Spacing="1">
                                            <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary" OnClick="() => SaveModel(context)">Save</MudButton>
                                            <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary" OnClick="() => TestModel(context)" Disabled="_isTesting">Test</MudButton>
                                            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Error" OnClick="() => DeleteModel(context.Id)">Delete</MudButton>
                                        </MudStack>
                                    </MudTd>
                                </RowTemplate>
                            </MudTable> *@
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            </MudTabPanel>

            <MudTabPanel Text="Image">
                <MudGrid>
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Info" Class="mb-3">
                            Configure image providers separately from text models. Use <strong>ComfyUI</strong> for local workflows at endpoints like <strong>http://127.0.0.1:8188</strong>, or <strong>OpenAI Images</strong> for cloud or compatible image APIs. The Test button below performs a real one-off image request and shows the preview here.
                        </MudAlert>
                    </MudItem>

                    <MudItem xs="12">
                        <MudPaper Class="pa-4 mb-4" Elevation="1">
                            <MudText Typo="Typo.h6">Image Connections</MudText>
                            <MudText Typo="Typo.body2" Class="mb-2">Configure endpoints for image generation backends.</MudText>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mb-3" OnClick="AddImageConnection">Add Image Connection</MudButton>

                            @foreach (var conn in AppState.ImageConnections)
                            {
                                <MudPaper Class="pa-3 mb-3" Elevation="0" Outlined="true">
                                    <MudGrid>
                                        <MudItem xs="3">
                                            <MudTextField @bind-Value="conn.Name" Label="Name" />
                                        </MudItem>
                                        <MudItem xs="3">
                                            <MudSelect @bind-Value="conn.Transport" Label="Transport" T="string">
                                                <MudSelectItem T="string" Value='@(ComfyUI)'>ComfyUI</MudSelectItem>
                                                <MudSelectItem T="string" Value='@(OpenAiImages)'>OpenAI Images</MudSelectItem>
                                                <MudSelectItem T="string" Value='@(EasyDiffusion)'>Easy Diffusion</MudSelectItem>
                                            </MudSelect>
                                        </MudItem>
                                        <MudItem xs="3">
                                            <MudTextField @bind-Value="conn.Endpoint" Label="Endpoint" Placeholder="http://127.0.0.1:8188" />
                                        </MudItem>
                                        <MudItem xs="3">
                                            <MudTextField @bind-Value="conn.ApiKey" Label="API Key" InputType="InputType.Password" />
                                        </MudItem>
                                        <MudItem xs="12">
                                            <MudText Typo="Typo.body2" Class="mb-2">@GetImageTransportHint(conn.Transport)</MudText>
                                            <MudStack Row="true" Spacing="2">
                                                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => SaveImageConnection(conn)">Save</MudButton>
                                                <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="() => DeleteImageConnection(conn.Id)">Delete</MudButton>
                                            </MudStack>
                                        </MudItem>
                                    </MudGrid>
                                </MudPaper>
                            }
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12">
                        <MudPaper Class="pa-4" Elevation="1">
                            <MudText Typo="Typo.h6">Image Model Catalog</MudText>
                            <MudText Typo="Typo.body2" Class="mb-2">Register image presets or provider-backed models. ComfyUI entries can use Workflow / Profile for either pasted API workflow JSON or a local file path.</MudText>
                            <MudTextField @bind-Value="_imageTestPrompt" Label="Test prompt" Lines="2" Class="mb-3" />
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mb-3" OnClick="AddImageModel">Add Image Model</MudButton>

                            @if (!string.IsNullOrEmpty(_imageTestResult))
                            {
                                <MudAlert Severity="@_imageTestSeverity" Class="mb-3" ShowCloseIcon="true" CloseIconClicked="ClearImageTestResult">
                                    @_imageTestResult
                                </MudAlert>
                            }

                            @if (!string.IsNullOrEmpty(_imagePreviewDataUrl))
                            {
                                <MudPaper Class="pa-3 mb-3" Outlined="true">
                                    <MudText Typo="Typo.subtitle2" Class="mb-2">Latest test preview</MudText>
                                    <img src="@_imagePreviewDataUrl" alt="Generated test preview" style="max-width:100%;max-height:420px;border-radius:8px;display:block;" />
                                </MudPaper>
                            }

                            @foreach (var model in AppState.ImageModels)
                            {
                                <MudPaper Class="pa-3 mb-3" Elevation="0" Outlined="true">
                                    <MudGrid>
                                        <MudItem xs="12" md="4">
                                            <MudTextField @bind-Value="model.Name" Label="Name" />
                                        </MudItem>
                                        <MudItem xs="12" md="4">
                                            <MudSelect @bind-Value="model.ConnectionId" Label="Connection" T="string">
                                                <MudSelectItem T="string" Value="@string.Empty">(Select connection)</MudSelectItem>
                                                @foreach (var conn in AppState.ImageConnections)
                                                {
                                                    <MudSelectItem T="string" Value="@conn.Id">@conn.Name</MudSelectItem>
                                                }
                                            </MudSelect>
                                        </MudItem>
                                        <MudItem xs="12" md="4">
                                            <MudTextField @bind-Value="model.ModelId" Label="Model ID" />
                                        </MudItem>
                                        <MudItem xs="12">
                                            <MudTextField @bind-Value="model.WorkflowId" Label="Workflow / Profile" Lines="4" />
                                        </MudItem>
                                        <MudItem xs="6" md="2">
                                            <MudNumericField @bind-Value="model.Width" Label="Width" Min="256" Max="2048" />
                                        </MudItem>
                                        <MudItem xs="6" md="2">
                                            <MudNumericField @bind-Value="model.Height" Label="Height" Min="256" Max="2048" />
                                        </MudItem>
                                        <MudItem xs="6" md="2">
                                            <MudNumericField @bind-Value="model.Steps" T="int?" Label="Steps" Min="1" Max="150" />
                                        </MudItem>
                                        <MudItem xs="6" md="2">
                                            <MudNumericField @bind-Value="model.GuidanceScale" T="double?" Label="Guidance" Min="0" Max="30" Step="0.5" />
                                        </MudItem>
                                        <MudItem xs="12" md="4">
                                            <MudTextField @bind-Value="model.NegativePrompt" Label="Negative Prompt" Lines="2" />
                                        </MudItem>
                                        <MudItem xs="12">
                                            <MudTextField @bind-Value="model.Notes" Label="Notes" Lines="2" />
                                        </MudItem>
                                        <MudItem xs="12">
                                            <MudText Typo="Typo.body2" Class="mb-2">@GetImageModelHint(model)</MudText>
                                            <MudStack Row="true" Spacing="2">
                                                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => SaveImageModel(model)">Save</MudButton>
                                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="() => TestImageModel(model)" Disabled="_isTestingImage">Test Image</MudButton>
                                                <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="() => DeleteImageModel(model.Id)">Delete</MudButton>
                                            </MudStack>
                                        </MudItem>
                                    </MudGrid>
                                </MudPaper>
                            }
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            </MudTabPanel>
        </MudTabs>
    </MudItem>
</MudGrid>
@code {
    protected override async Task OnInitializedAsync()
    {
        AppState.OnChange += StateHasChanged;
        await AppState.LoadAsync();
    }

    private async Task AddConnection()
    {
        var conn = new AiConnection { Name = "New Connection", SortOrder = AppState.Connections.Count };
        await AppState.SaveConnectionAsync(conn);
    }

    private async Task SaveConnection(AiConnection conn)
    {
        await AppState.SaveConnectionAsync(conn);
        if (!AppState.Settings.SetupModelsCompleted)
        {
            AppState.Settings.SetupModelsCompleted = true;
            await AppState.SaveSettingsAsync();
        }
    }

    private async Task DeleteConnection(string id) => await AppState.DeleteConnectionAsync(id);

    private async Task AddModel()
    {
        var model = new AiModel { Name = "New Model", SortOrder = AppState.Models.Count };
        await AppState.SaveModelAsync(model);
    }

    private async Task SaveModel(AiModel model)
    {
        await AppState.SaveModelAsync(model);
        if (!AppState.Settings.SetupModelsCompleted)
        {
            AppState.Settings.SetupModelsCompleted = true;
            await AppState.SaveSettingsAsync();
        }
    }

    private async Task DeleteModel(string id) => await AppState.DeleteModelAsync(id);

    private async Task AddImageConnection()
    {
        var conn = new ImageConnection { Name = "New Image Connection", SortOrder = AppState.ImageConnections.Count };
        await AppState.SaveImageConnectionAsync(conn);
    }

    private async Task SaveImageConnection(ImageConnection connection)
    {
        await AppState.SaveImageConnectionAsync(connection);
        if (!AppState.Settings.SetupModelsCompleted)
        {
            AppState.Settings.SetupModelsCompleted = true;
            await AppState.SaveSettingsAsync();
        }
    }

    private async Task DeleteImageConnection(string id) => await AppState.DeleteImageConnectionAsync(id);

    private async Task AddImageModel()
    {
        var model = new ImageModel { Name = "New Image Model", SortOrder = AppState.ImageModels.Count };
        await AppState.SaveImageModelAsync(model);
    }

    private async Task SaveImageModel(ImageModel model)
    {
        await AppState.SaveImageModelAsync(model);
        if (!AppState.Settings.SetupModelsCompleted)
        {
            AppState.Settings.SetupModelsCompleted = true;
            await AppState.SaveSettingsAsync();
        }
    }

    private async Task DeleteImageModel(string id) => await AppState.DeleteImageModelAsync(id);

    private bool _isTesting;
    private string _testResult = string.Empty;
    private Severity _testSeverity = Severity.Info;
    private bool _isTestingImage;
    private string _imageTestPrompt = "cinematic fantasy tavern scene, warm lantern light, detailed characters, high detail";
    private string _imageTestResult = string.Empty;
    private Severity _imageTestSeverity = Severity.Info;
    private string _imagePreviewDataUrl = string.Empty;

    private async Task TestModel(AiModel model)
    {
        var connection = AppState.Connections.FirstOrDefault(c => c.Id == model.ConnectionId);
        if (connection is null)
        {
            _testResult = "No connection found for this model. Save the model with a valid connection first.";
            _testSeverity = Severity.Warning;
            return;
        }

        _isTesting = true;
        _testResult = $"Testing {model.Name}...";
        _testSeverity = Severity.Info;
        StateHasChanged();

        try
        {
            var provider = LlmProviderMapping.FromTransport(connection.Transport);

            var settings = new LlmRequestSettings(
                provider, connection.Endpoint, model.ModelId, connection.ApiKey, model.Temperature,
                80, connection.Transport, connection.Name);

            var result = await LlmClient.CompleteAsync(settings,
                [new LlmChatMessage("user", "Reply with exactly: CONNECTION OK")],
                CancellationToken.None);

            var preview = result.Content.Length > 180 ? result.Content[..180] + "..." : result.Content;
            _testResult = $"Test passed for '{model.Name}'. Response: {preview}";
            _testSeverity = Severity.Success;
            await SaveModel(model);
        }
        catch (Exception ex)
        {
            _testResult = $"Test failed for '{model.Name}': {ex.Message}";
            _testSeverity = Severity.Error;
        }
        finally
        {
            _isTesting = false;
        }
    }

    private async Task TestImageModel(ImageModel model)
    {
        var connection = AppState.ImageConnections.FirstOrDefault(c => c.Id == model.ConnectionId);
        if (connection is null)
        {
            _imageTestResult = "No image connection found for this model. Save the model with a valid image connection first.";
            _imageTestSeverity = Severity.Warning;
            _imagePreviewDataUrl = string.Empty;
            return;
        }

        _isTestingImage = true;
        _imageTestResult = $"Generating a test image with {model.Name}...";
        _imageTestSeverity = Severity.Info;
        _imagePreviewDataUrl = string.Empty;
        StateHasChanged();

        try
        {
            var result = await ImageClient.GenerateTestImageAsync(connection, model, _imageTestPrompt, CancellationToken.None);
            _imageTestResult = result.Message;
            _imageTestSeverity = Severity.Success;
            _imagePreviewDataUrl = $"data:{result.MimeType};base64,{Convert.ToBase64String(result.ImageBytes)}";
        }
        catch (Exception ex)
        {
            _imageTestResult = $"Image test failed for '{model.Name}': {ex.Message}";
            _imageTestSeverity = Severity.Error;
            _imagePreviewDataUrl = string.Empty;
        }
        finally
        {
            _isTestingImage = false;
        }
    }

    private void ClearTextTestResult() => _testResult = string.Empty;

    private void ClearImageTestResult()
    {
        _imageTestResult = string.Empty;
        _imagePreviewDataUrl = string.Empty;
    }

    private static string GetImageTransportHint(string transport) => transport switch
    {
        ComfyUI => "ComfyUI uses its local HTTP API. Set the endpoint to the server root and provide an API workflow JSON or file path on the model entry.",
        OpenAiImages => "Use this for OpenAI-style image endpoints. Set the endpoint to the API root or /v1 base and provide the image model id on the model entry.",
        _ => "Configure the endpoint and credentials for the selected image transport.",
    };

    private string GetImageModelHint(ImageModel model)
    {
        var connection = AppState.ImageConnections.FirstOrDefault(c => c.Id == model.ConnectionId);
        return connection?.Transport switch
        {
            ComfyUI => "ComfyUI test generation will submit the workflow, replace placeholders like {{prompt}} and {{width}}, then poll the history API for the output image.",
            OpenAiImages => "OpenAI-style test generation sends a one-off prompt to the image endpoint using the selected model id and resolution.",
            _ => "Choose a saved image connection to enable provider-specific test generation.",
        };
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
    }
}
