@page "/rooms"
@inject RoomState RoomState
@inject AppState AppState
@inject AgentGroupChat.Core.Services.SpeechService Speech
@using AgentGroupChat.Core.Services

@implements IDisposable
@attribute [Authorize]

<MudGrid Justify="Justify.Center">    
    <MudItem xs="2" sm="3">
        <MudPaper Class="pa-4" Elevation="1">
            <MudGrid>
                <MudItem xs="12">
                    <MudText Typo="Typo.h5">Room List</MudText>
                </MudItem>
                <MudItem xs="12">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="my-2" OnClick="AddRoom">Add Room</MudButton>
                </MudItem>
                <MudItem xs="12">
                    <MudText Typo="Typo.caption">
                        Rooms are self-contained environments where agents interact with other agents, or with the user. 
                        Set up different rooms for different purposes, such as work, personal, or testing.
                        Configure Room Settings and Agents in the tabs below. Remember to save your changes!
                        </MudText>
                </MudItem>
                <MudItem xs="12">
                    <MudList T="string" Dense="true" @bind-SelectedValue="_selectedRoomId">
                        @foreach (var room in RoomState.Rooms)
                        {
                            <MudListItem T="string" Value="@room.Id" OnClick="() => SelectRoomAsync(room)">
                                @room.Name
                            </MudListItem>
                        }
                    </MudList>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </MudItem>

    <MudItem xs="8" sm="9">
        @if (RoomState.SelectedRoom is not null)
        {
            var room = RoomState.SelectedRoom;
            <MudPaper Class="pa-4" Elevation="1">
                <MudTabs @bind-ActivePanelIndex="_activeRoomTab" Rounded="true" Class="mb-4">
                    <MudTabPanel Text="Room Settings">
                        <RoomSettingsEditor Room="room"
                                            Models="AppState.Models"
                                            ImageModels="AppState.ImageModels"
                                            OnSpeechSettingsChanged="RefreshKokoroVoicesAsync" />
                    </MudTabPanel>

                    <MudTabPanel Text="Agents">
                        <RoomAgentsEditor Room="room"
                                            Models="AppState.Models"
                                            KokoroVoices="_kokoroVoices"
                                            IsDark="_isDark"
                                            IsPreviewingVoice="_previewingVoice"
                                            PreviewAgentId="_previewAgent"
                                            OnTestAgentVoice="TestAgentVoice" />
                    </MudTabPanel>

                    <MudTabPanel Text="Data Trackers">
                        <MudText Typo="Typo.h4" Class="mt-4 mb-2">Track Room & Participant Data</MudText>
                        
                        @if (String.IsNullOrWhiteSpace(RoomState.SelectedRoom.PrivilegedAgentId))
                        {
                            <MudText Class="ml-4">A privileged agent must be defined to enable data tracking on the room.</MudText>
                        }
                        else
                        {
                            <MudButton Class="ml-4 mb-4" Variant="Variant.Filled" OnClick="AddDataTrackingPoint">Add New Tracker</MudButton>

                            <MudGrid Class="mx-4">
                                @foreach (var point in RoomState.SelectedRoom.DataTrackers)
                                {
                                    <MudItem xs="2">
                                        <MudTextField @bind-Value="point.DataKey" Label="Name" />
                                    </MudItem>
                                    <MudItem xs="2">
                                        <MudSelect @bind-Value="point.ValueType" Label="Type">
                                            <MudSelectItem Value="@("string")">String</MudSelectItem>
                                            <MudSelectItem Value="@("int")">Integer</MudSelectItem>
                                            <MudSelectItem Value="@("decimal")">Decimal</MudSelectItem>
                                            <MudSelectItem Value="@("bool")">T/F</MudSelectItem>
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="2">
                                        <MudTextField @bind-Value="point.Value" Label="Value" Validation="@((Func<string, string>)(v => ValidateCustomValue(v, point)))" />
                                    </MudItem>
                                    @if (point.ValueType == "int" || point.ValueType == "decimal")
                                    {
                                        <MudItem xs="2">
                                            <MudNumericField @bind-Value="point.MinValue" Label="MinValue" HideSpinButtons="true" />
                                        </MudItem>
                                        <MudItem xs="2">
                                            <MudNumericField @bind-Value="point.MaxValue" Label="MinValue" />
                                        </MudItem>
                                    }
                                    <MudItem xs="11">
                                        <MudTextField @bind-Value="point.PromptText" Label="Agent Prompt Text" Lines="3"/>
                                    </MudItem>
                                    <MudItem xs="11">
                                        <MudTextField @bind-Value="point.PrivilegedAgentPrompt" Label="Privileged Agent Prompt Text" Lines="3" />
                                    </MudItem>

                                    <MudItem xs="3">
                                        <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="() => DeleteDataPoint(point)">Delete</MudButton>
                                    </MudItem>
                                    <MudItem xs="9">
                                        <MudText>&nbsp;</MudText>
                                    </MudItem>
                                }
                            </MudGrid>
                        }
                    </MudTabPanel>

                    @* <MudTabPanel Text="Human Participants">
                        <RoomHumanParticipantsEditor Room="room"
                                                        KokoroVoices="_kokoroVoices"
                                                        IsDark="_isDark" />
                    </MudTabPanel> *@
                </MudTabs>

                <MudDivider Class="my-4" />
                <MudText Typo="Typo.caption" Class="mb-2">Save persists the selected room, agents, and human participants across all tabs.</MudText>
                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveRoom">Save Room</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="DeleteRoom">Delete Room</MudButton>
                </MudStack>
            </MudPaper>
        }
        else
        {
            <MudPaper Class="pa-4" Elevation="1">
                <MudText>Select a room from the list or add a new one.</MudText>
            </MudPaper>
        }
    </MudItem>
</MudGrid>
    


@code {
    private string _selectedRoomId = string.Empty;
    private int _activeRoomTab;
    private bool _isDark => AppState.Settings.UiTheme == "Dark";
    private List<string> _kokoroVoices = new();
    private bool _previewingVoice;
    private string _previewAgent = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (!AppState.IsLoaded)
            await AppState.LoadAsync();
        await RoomState.LoadAsync();
        RoomState.OnChange += StateHasChanged;
        await RefreshKokoroVoicesAsync();
    }

    private async Task SelectRoomAsync(RoomConfig room)
    {
        _selectedRoomId = room.Id;
        RoomState.SelectRoom(room);
        await RefreshKokoroVoicesAsync();
    }

    private async Task AddRoom()
    {
        var room = new RoomConfig
        {
            Name = $"Room {RoomState.Rooms.Count + 1}",
            SortOrder = RoomState.Rooms.Count,
        };
        await RoomState.SaveRoomAsync(room);
        var savedRoom = RoomState.Rooms.FirstOrDefault(r => r.Id == room.Id) ?? room;
        _selectedRoomId = savedRoom.Id;
        RoomState.SelectRoom(savedRoom);

        if (!AppState.Settings.SetupRoomsCompleted)
        {
            AppState.Settings.SetupRoomsCompleted = true;
            await AppState.SaveSettingsAsync();
        }
    }

    private async Task SaveRoom()
    {
        if (RoomState.SelectedRoom is null) return;
        await RoomState.SaveRoomAsync(RoomState.SelectedRoom);

        if (!AppState.Settings.SetupRoomsCompleted)
        {
            AppState.Settings.SetupRoomsCompleted = true;
            await AppState.SaveSettingsAsync();
        }
    }

    private async Task DeleteRoom()
    {
        if (RoomState.SelectedRoom is null) return;
        await RoomState.DeleteRoomAsync(RoomState.SelectedRoom.Id);
    }

    private async Task RefreshKokoroVoicesAsync()
    {
        var room = RoomState.SelectedRoom;
        if (room is null || !RoomSpeechResolver.UsesKokoro(room, AppState.Settings))
        {
            _kokoroVoices.Clear();
            await InvokeAsync(StateHasChanged);
            return;
        }

        var voices = await Speech.FetchKokoroVoicesAsync(AppState.Settings.KokoroBaseUrl);
        _kokoroVoices = voices.ToList();
        await InvokeAsync(StateHasChanged);
    }

    private async Task TestAgentVoice(AgentConfig agent)
    {
        var room = RoomState.SelectedRoom;
        if (room is null) return;

        if (_previewingVoice) return;
        _previewingVoice = true;
        _previewAgent = agent.Id;
        StateHasChanged();
        try
        {
            var settings = BuildSpeechSettings(room, forceEnabled: true);
            var voice = string.IsNullOrWhiteSpace(agent.TtsVoice)
                ? RoomSpeechResolver.GetFallbackVoice(room, AppState.Settings)
                : agent.TtsVoice;
            await Speech.SpeakAsync(settings, $"Hello, this is {agent.Name}.", voice, CancellationToken.None);
        }
        finally
        {
            _previewingVoice = false;
            _previewAgent = string.Empty;
            StateHasChanged();
        }
    }

    private SpeechService.SpeechSettings BuildSpeechSettings(RoomConfig room, bool forceEnabled = false) =>
        RoomSpeechResolver.BuildSettings(room, AppState.Settings, forceEnabled);

    public void Dispose()
    {
        RoomState.OnChange -= StateHasChanged;
    }

    private async Task AddDataTrackingPoint()
    {
        var room = RoomState.SelectedRoom;
        if (room is null) return;

        room.DataTrackers.Add(new DataTrackerConfig() { RoomId = room.Id });
    }


    private async Task DeleteDataPoint(DataTrackerConfig point)
    {
        var room = RoomState.SelectedRoom.DataTrackers.Remove(point);
        
    }

    private string ValidateCustomValue(string value, DataTrackerConfig point)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "Value is required";

        switch (point.ValueType)
        {
            case "string":
                return null;

            case "int":
                return int.TryParse(value, out _)
                    ? null
                    : "Must be a valid integer";

            case "decimal":
                return decimal.TryParse(value, out _)
                    ? null
                    : "Must be a valid decimal";

            case "bool":
                return bool.TryParse(value, out _)
                    ? null
                    : "Must be true/false";

            default:
                return "Unknown type";
        }
    }
}