@page "/rooms"
@inject RoomState RoomState
@inject AppState AppState
@inject RoomInviteState RoomInviteState
@inject ISnackbar Snackbar
@inject AgentGroupChat.Core.Services.SpeechService Speech
@using System.Security.Claims
@using AgentGroupChat.Core.Services
@using Microsoft.AspNetCore.Components.Authorization
@using AgentGroupChat.Core.Realtime
@inject AuthenticationStateProvider AuthStateProvider
@inject AgentGroupChat.Core.Realtime.IRoomLiveUpdateNotifier RoomLiveUpdates

@implements IDisposable //Future move to IAsyncDisposable?? TODO research
@attribute [Authorize]

<MudGrid Justify="Justify.Center">    
    <MudItem xs="2" sm="3">
        <MudPaper Class="pa-4" Elevation="1">
            <MudGrid>
                <MudItem xs="6">
                    <MudText Typo="Typo.h5">Room List</MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="my-2" OnClick="AddRoom">Create Room</MudButton>
                </MudItem>
                
                <MudItem xs="12">
                    <MudText>
                        Rooms are self-contained environments where agents interact with other agents, or with the user. <br />
                        </MudText>
                </MudItem>
                <MudItem xs="12">
                    <MudList T="string" Dense="true" @bind-SelectedValue="_selectedRoomId">
                        @foreach (var room in RoomState.Rooms)
                        {
                            <MudListItem T="string" Value="@room.Id" OnClick="() => SelectRoomAsync(room)">
                                @room.Name
                                &nbsp;
                                @if (room.UserId != accessingUserId)
                                {
                                    <MudChip T="string" Color="Color.Secondary" Size="Size.Small">Guest</MudChip>
                                }
                            </MudListItem>
                        }
                    </MudList>
                </MudItem>
                <br />
                <MudDivider Style="width: 80%" />
                <br />
                <MudItem xs="12">
                    <MudGrid>
                        <MudItem xs="12">
                            <MudText Typo="Typo.h5" Color="Color.Primary">Redeem Invite</MudText>
                        </MudItem>
                        <MudItem xs="12">
                            <MudText>Redeem an invite to join another player's room</MudText>
                        </MudItem>
                        <MudItem xs="6">
                            <MudTextField Label="Redeem Invite" @bind-Value="redeemCode" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" class="mb-3" onclick="RedeemInvite">Redeem Invite</MudButton>
                        </MudItem>
                    </MudGrid>
                </MudItem>
                @* <MudItem xs="12">
                    <MudGrid>
                        <MudItem xs="12">
                            <MudText Typo="Typo.h5" Color="Color.Primary">Other Player's Rooms</MudText>
                        </MudItem>
                        <MudItem xs="12">
                            <MudText>Redeem an invite to join another player's room</MudText>
                        </MudItem>
                        <MudItem xs="12">
                            <MudList T="string" Dense="true" @bind-SelectedValue="_selectedRoomId">
                                @foreach (var room in RoomState.Rooms)
                                {
                                    <MudListItem T="string" Value="@room.Id" OnClick="() => SelectRoomAsync(room)">
                                        @room.Name
                                    </MudListItem>
                                }
                            </MudList>
                        </MudItem>
                    </MudGrid>
                </MudItem> *@
            </MudGrid>
        </MudPaper>
    </MudItem>

    <MudItem xs="8" sm="9">
        @if (RoomState.SelectedRoom is not null)
        {
            var room = RoomState.SelectedRoom;
            <MudPaper Class="pa-4" Elevation="1">
                <MudTabs @bind-ActivePanelIndex="_activeRoomTab" Rounded="true" Class="mb-4">
                    <MudTabPanel Text="Room Settings">
                        <RoomSettingsEditor Room="room"
                                            Models="AppState.Models"
                                            ImageModels="AppState.ImageModels"
                                            OnSpeechSettingsChanged="RefreshKokoroVoicesAsync" />
                    </MudTabPanel>

                    <MudTabPanel Text="Agents">
                        <RoomAgentsEditor Room="room"
                                            Models="AppState.Models"
                                            KokoroVoices="_kokoroVoices"
                                            IsDark="_isDark"
                                            IsPreviewingVoice="_previewingVoice"
                                            PreviewAgentId="_previewAgent"
                                            OnTestAgentVoice="TestAgentVoice" />
                    </MudTabPanel>

                    <MudTabPanel Text="Data Trackers">
                        <MudText Typo="Typo.h4" Class="mt-4 mb-2">Track Room & Participant Data</MudText>
                        
                        @if (String.IsNullOrWhiteSpace(RoomState.SelectedRoom.PrivilegedAgentId))
                        {
                            <MudText Class="ml-4">A privileged agent must be defined to enable data tracking on the room.</MudText>
                        }
                        else
                        {
                            <MudButton Class="ml-4 mb-4" Variant="Variant.Filled" OnClick="AddDataTrackingPoint" Disabled="@isNotRoomOwner">Add New Tracker</MudButton>

                            <MudGrid Class="mx-4">
                                @foreach (var point in RoomState.SelectedRoom.DataTrackers)
                                {
                                    <MudItem xs="2">
                                        <MudTextField @bind-Value="point.DataKey" Label="Name" Disabled="@isNotRoomOwner" />
                                    </MudItem>
                                    <MudItem xs="2">
                                        <MudSelect @bind-Value="point.ValueType" Label="Type" Disabled="@isNotRoomOwner">
                                            <MudSelectItem Value="@("string")">String</MudSelectItem>
                                            <MudSelectItem Value="@("int")">Integer</MudSelectItem>
                                            <MudSelectItem Value="@("decimal")">Decimal</MudSelectItem>
                                            <MudSelectItem Value="@("bool")">T/F</MudSelectItem>
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="2">
                                        <MudTextField @bind-Value="point.Value" Label="Value" Validation="@((Func<string, string>)(v => ValidateCustomValue(v, point)))" Disabled="@isNotRoomOwner" />
                                    </MudItem>
                                    @if (point.ValueType == "int" || point.ValueType == "decimal")
                                    {
                                        <MudItem xs="2">
                                            <MudNumericField @bind-Value="point.MinValue" Label="MinValue" HideSpinButtons="true" Disabled="@isNotRoomOwner" />
                                        </MudItem>
                                        <MudItem xs="2">
                                            <MudNumericField @bind-Value="point.MaxValue" Label="MaxValue" Disabled="@isNotRoomOwner" />
                                        </MudItem>
                                    }
                                    <MudItem xs="11">
                                        <MudTextField @bind-Value="point.PromptText" Label="Agent Prompt Text" Lines="3" Disabled="@isNotRoomOwner" />
                                    </MudItem>
                                    <MudItem xs="11">
                                        <MudTextField @bind-Value="point.PrivilegedAgentPrompt" Label="Privileged Agent Prompt Text" Lines="3" Disabled="@isNotRoomOwner" />
                                    </MudItem>

                                    <MudItem xs="3">
                                        <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="() => DeleteDataPoint(point)" Disabled="@isNotRoomOwner">Delete</MudButton>
                                    </MudItem>
                                    <MudItem xs="9">
                                        <MudText>&nbsp;</MudText>
                                    </MudItem>
                                }
                            </MudGrid>
                        }
                    </MudTabPanel>                    
                </MudTabs>

                <MudDivider Class="my-4" />
                <MudText Typo="Typo.caption" Class="mb-2">Save persists the selected room, agents, and data trackers across all tabs.</MudText>
                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveRoom" Disabled="@isNotRoomOwner">Save Room</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="DeleteRoom" Disabled="@isNotRoomOwner">Delete Room</MudButton>
                </MudStack>
            </MudPaper>
        }
        else
        {
            <MudPaper Class="pa-4" Elevation="1">
                <MudText>Select a room from the list or add a new one.</MudText>
            </MudPaper>
        }
    </MudItem>
</MudGrid>
    


@code {
    private string _selectedRoomId = string.Empty;
    private int _activeRoomTab;
    private bool _isDark => AppState.Settings.UiTheme == "Dark";
    private List<string> _kokoroVoices = new();
    private bool _previewingVoice;
    private string _previewAgent = string.Empty;
    private string redeemCode = string.Empty;
    private bool isNotRoomOwner = false;
    public string accessingUserId = "";
    public ClaimsPrincipal user;
    private IDisposable? _roomLiveSubscription;

    protected override async Task OnInitializedAsync()
    {
        if (!AppState.IsLoaded)
            await AppState.LoadAsync();
        await RoomState.LoadAsync();
        RoomState.OnChange += UpdateSelectedRoom;
        await RefreshKokoroVoicesAsync();

        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        user = state.User;
        accessingUserId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        isNotRoomOwner = RoomState.SelectedRoom?.UserId != accessingUserId;

        SubscribeToRoomLiveUpdates(RoomState.SelectedRoom?.Id);
    }

    private void UpdateSelectedRoom()
    {
        accessingUserId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        isNotRoomOwner = RoomState.SelectedRoom?.UserId != accessingUserId;
        StateHasChanged();
    }

    private void SubscribeToRoomLiveUpdates(string? roomId)
    {
        _roomLiveSubscription?.Dispose();
        _roomLiveSubscription = null;

        if (string.IsNullOrWhiteSpace(roomId))
            return;

        _roomLiveSubscription = RoomLiveUpdates.Subscribe(roomId, HandleRoomLiveUpdateAsync);
    }

    private Task HandleRoomLiveUpdateAsync(RoomLiveEvent update)
    {
        return InvokeAsync(async () =>
        {
            switch (update.Kind)
            {
                case RoomLiveEventKinds.RosterChanged:
                case RoomLiveEventKinds.RoomUpdated:
                case RoomLiveEventKinds.RoomDeleted:
                    {
                        var selectedRoomId = RoomState.SelectedRoom?.Id;

                        await RoomState.LoadAsync();

                        if (!string.IsNullOrWhiteSpace(selectedRoomId))
                        {
                            var selectedRoom = RoomState.Rooms.FirstOrDefault(r => r.Id == selectedRoomId);
                            if (selectedRoom is not null)
                            {
                                _selectedRoomId = selectedRoom.Id;
                                RoomState.SelectRoom(selectedRoom);
                            }
                        }
                        StateHasChanged();
                        break;
                    }
                default:
                    break;
            }
            
        });
    }

    private async Task SelectRoomAsync(RoomConfig room)
    {
        _selectedRoomId = room.Id;
        RoomState.SelectRoom(room);
        SubscribeToRoomLiveUpdates(room.Id);
        await RefreshKokoroVoicesAsync();
    }

    private async Task AddRoom()
    {
        var room = new RoomConfig
        {
            Name = $"Room {RoomState.Rooms.Count + 1}",
            SortOrder = RoomState.Rooms.Count,
        };
        await RoomState.SaveRoomAsync(room);
        var savedRoom = RoomState.Rooms.FirstOrDefault(r => r.Id == room.Id) ?? room;
        _selectedRoomId = savedRoom.Id;
        RoomState.SelectRoom(savedRoom);

        if (!AppState.Settings.SetupRoomsCompleted)
        {
            AppState.Settings.SetupRoomsCompleted = true;
            await AppState.SaveSettingsAsync();
        }
    }

    private async Task SaveRoom()
    {
        if (RoomState.SelectedRoom is null) return;
        await RoomState.SaveRoomAsync(RoomState.SelectedRoom);

        if (!AppState.Settings.SetupRoomsCompleted)
        {
            AppState.Settings.SetupRoomsCompleted = true;
            await AppState.SaveSettingsAsync();
        }
    }

    private async Task DeleteRoom()
    {
        if (RoomState.SelectedRoom is null) return;
        await RoomState.DeleteRoomAsync(RoomState.SelectedRoom.Id);
    }

    private async Task RedeemInvite()
    {
        try {
            var result = await RoomInviteState.RedeemAsync(new Guid(redeemCode));
            if (result.Succeeded)
            {
                await RoomState.LoadAsync();

                var redeemedRoom = RoomState.Rooms.FirstOrDefault(r => r.Id == result.RoomId);
                if (redeemedRoom is not null)
                {
                    _selectedRoomId = redeemedRoom.Id;
                    RoomState.SelectRoom(redeemedRoom);
                    SubscribeToRoomLiveUpdates(redeemedRoom.Id);
                }

                Snackbar.Add("Invite redeemed!", Severity.Success);
                redeemCode = string.Empty;
            }
            else
            {
                Snackbar.Add(
    string.IsNullOrWhiteSpace(result.FailureReason)
        ? "Failed to redeem invite. Please check the code and try again."
        : result.FailureReason,
    Severity.Error);
            }
        }
        catch
        {
            Snackbar.Add("Failed to redeem invite. Please check the code and try again.", Severity.Error);
        }
        await RoomState.LoadAsync();
        StateHasChanged();
    }

    private async Task RefreshKokoroVoicesAsync()
    {
        var room = RoomState.SelectedRoom;
        if (room is null || !RoomSpeechResolver.UsesKokoro(room, AppState.Settings))
        {
            _kokoroVoices.Clear();
            await InvokeAsync(StateHasChanged);
            return;
        }

        var voices = await Speech.FetchKokoroVoicesAsync(AppState.Settings.KokoroBaseUrl);
        _kokoroVoices = voices.ToList();
        await InvokeAsync(StateHasChanged);
    }

    private async Task TestAgentVoice(AgentConfig agent)
    {
        var room = RoomState.SelectedRoom;
        if (room is null) return;

        if (_previewingVoice) return;
        _previewingVoice = true;
        _previewAgent = agent.Id;
        StateHasChanged();
        try
        {
            var settings = BuildSpeechSettings(room, forceEnabled: true);
            var voice = string.IsNullOrWhiteSpace(agent.TtsVoice)
                ? RoomSpeechResolver.GetFallbackVoice(room, AppState.Settings)
                : agent.TtsVoice;
            await Speech.SpeakAsync(settings, $"Hello, this is {agent.Name}.", voice, CancellationToken.None);
        }
        finally
        {
            _previewingVoice = false;
            _previewAgent = string.Empty;
            StateHasChanged();
        }
    }

    private SpeechService.SpeechSettings BuildSpeechSettings(RoomConfig room, bool forceEnabled = false) =>
        RoomSpeechResolver.BuildSettings(room, AppState.Settings, forceEnabled);

    public void Dispose()
    {
        RoomState.OnChange -= UpdateSelectedRoom;
        _roomLiveSubscription?.Dispose();
    }

    private async Task AddDataTrackingPoint()
    {
        var room = RoomState.SelectedRoom;
        if (room is null) return;

        room.DataTrackers.Add(new DataTrackerConfig() { RoomId = room.Id });
    }


    private async Task DeleteDataPoint(DataTrackerConfig point)
    {
        var room = RoomState.SelectedRoom.DataTrackers.Remove(point);
        
    }

    private string ValidateCustomValue(string value, DataTrackerConfig point)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "Value is required";

        switch (point.ValueType)
        {
            case "string":
                return null;

            case "int":
                return int.TryParse(value, out _)
                    ? null
                    : "Must be a valid integer";

            case "decimal":
                return decimal.TryParse(value, out _)
                    ? null
                    : "Must be a valid decimal";

            case "bool":
                return bool.TryParse(value, out _)
                    ? null
                    : "Must be true/false";

            default:
                return "Unknown type";
        }
    }
}