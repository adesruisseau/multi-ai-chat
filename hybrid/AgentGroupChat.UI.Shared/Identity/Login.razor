@page "/login"
@inject NavigationManager NavigationManager

<MudContainer MaxWidth="MaxWidth.Small" Class="my-12">
    <MudPaper Class="pa-6 d-flex flex-column align-center" Elevation="2">
        <MudText Typo="Typo.h6">Redirecting to sign in...</MudText>
    </MudPaper>
</MudContainer>

@code {
    protected override void OnAfterRender(bool firstRender)
    {
        NavigationManager.NavigateTo("/login", forceLoad: true);
    }
}
