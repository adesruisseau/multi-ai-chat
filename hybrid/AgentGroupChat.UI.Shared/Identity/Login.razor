@page "/login"
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms

<MudGrid Justify="Justify.Center" Spacing="4">
    <MudItem xs="12" sm="10" md="8">
        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">@Error</MudAlert>
        }
    </MudItem>

    <MudItem xs="12" md="4">
        <MudCard>
            <MudCardHeader>
                <MudText>Enter your username and password.</MudText>
            </MudCardHeader>
            <MudCardContent>
                <form method="post" action="/auth/login">
                    <AntiforgeryToken />
                    <input type="hidden" name="returnUrl" value="@ReturnUrlValue" />

                    <MudStack Spacing="2">
                        <div>
                            <MudText Typo="Typo.caption">Username</MudText>
                            <input name="UserName" type="text" autocomplete="username" required style="width:100%;padding:0.85rem;border:1px solid rgba(0,0,0,0.23);border-radius:4px;background:transparent;" />
                        </div>

                        <div>
                            <MudText Typo="Typo.caption">Password</MudText>
                            <input name="Password" type="password" autocomplete="current-password" required style="width:100%;padding:0.85rem;border:1px solid rgba(0,0,0,0.23);border-radius:4px;background:transparent;" />
                        </div>

                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Login</MudButton>
                    </MudStack>
                </form>
            </MudCardContent>
        </MudCard>
    </MudItem>

    <MudItem xs="12" md="4">
        <MudCard>
            <MudCardHeader>
                <MudText>Register for an account.</MudText>
            </MudCardHeader>
            <MudCardContent>
                <form method="post" action="/auth/register">
                    <AntiforgeryToken />
                    <input type="hidden" name="returnUrl" value="@ReturnUrlValue" />

                    <MudStack Spacing="2">
                        <div>
                            <MudText Typo="Typo.caption">Email</MudText>
                            <input name="Email" type="email" autocomplete="email" required style="width:100%;padding:0.85rem;border:1px solid rgba(0,0,0,0.23);border-radius:4px;background:transparent;" />
                        </div>

                        <div>
                            <MudText Typo="Typo.caption">Username</MudText>
                            <input name="UserName" type="text" autocomplete="username" required style="width:100%;padding:0.85rem;border:1px solid rgba(0,0,0,0.23);border-radius:4px;background:transparent;" />
                        </div>

                        <div>
                            <MudText Typo="Typo.caption">Password</MudText>
                            <input name="Password" type="password" autocomplete="new-password" required style="width:100%;padding:0.85rem;border:1px solid rgba(0,0,0,0.23);border-radius:4px;background:transparent;" />
                        </div>

                        <div>
                            <MudText Typo="Typo.caption">Confirm Password</MudText>
                            <input name="ConfirmPassword" type="password" autocomplete="new-password" required style="width:100%;padding:0.85rem;border:1px solid rgba(0,0,0,0.23);border-radius:4px;background:transparent;" />
                        </div>

                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Register</MudButton>
                    </MudStack>
                </form>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private string ReturnUrlValue => string.IsNullOrWhiteSpace(ReturnUrl) ? "/" : ReturnUrl!;
}
