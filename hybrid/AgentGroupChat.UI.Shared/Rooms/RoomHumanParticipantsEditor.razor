@using AgentGroupChat.Core.Models.Domain


<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mt-4 mb-3 flex-wrap">
    <MudText Typo="Typo.h5">Human Participants</MudText>
    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@($"{Room.HumanParticipants.Count} total")</MudChip>
    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@($"{Room.HumanParticipants.Count(h => h.IsEnabled)} enabled")</MudChip>
</MudStack>

<MudText Typo="Typo.caption" Class="mb-3">
    Human participants are named characters in the room who take turns alongside AI agents.
    When no human participants are defined, the local user speaks as "You" by default.
</MudText>

<MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="mb-3" OnClick="AddHumanParticipant">Add Human Participant</MudButton>

@foreach (var human in Room.HumanParticipants)
{
    <MudPaper Class="pa-3 mb-3" Elevation="0" Outlined="true">
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="human.Name" Label="Name" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudSwitch @bind-Value="human.IsEnabled" Label="Enabled" Color="Color.Primary" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudSwitch @bind-Value="human.IsPlayerCharacter" Label="Player Character" Color="Color.Primary" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudSelect @bind-Value="human.ParticipationMode" Label="Participation Mode" T="ParticipationMode">
                    <MudSelectItem T="ParticipationMode" Value="ParticipationMode.TurnParticipant">Turn Participant</MudSelectItem>
                    <MudSelectItem T="ParticipationMode" Value="ParticipationMode.InterventionOnly">Intervention Only</MudSelectItem>
                    <MudSelectItem T="ParticipationMode" Value="ParticipationMode.Observer">Observer</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="4">
                @if (KokoroVoices.Count > 0)
                {
                    <MudSelect @bind-Value="human.TtsVoice" Label="TTS Voice" ShrinkLabel="true" T="string">
                        <MudSelectItem T="string" Value="@string.Empty">(Default)</MudSelectItem>
                        @foreach (var voice in KokoroVoices)
                        {
                            <MudSelectItem T="string" Value="@voice">@voice</MudSelectItem>
                        }
                    </MudSelect>
                }
                else
                {
                    <MudTextField @bind-Value="human.TtsVoice" Label="TTS Voice" />
                }
            </MudItem>
            <MudItem xs="12" md="4">
                <MudSelect Value="human.AccentHex" ValueChanged="@((string value) => OnHumanColorChanged(human, value))" Label="Chat color" T="string">
                    @foreach (var preset in AgentColorPresets.GetPresets(IsDark))
                    {
                        <MudSelectItem T="string" Value="@preset.AccentHex">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.Circle" Style="@($"color:{preset.AccentHex}")" Size="Size.Small" />
                                @preset.Name
                            </MudStack>
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            @if (Room.EnableSceneImageGeneration && Room.UseCreativeImageGeneration)
            {
                <MudItem xs="12">
                    <MudTextField @bind-Value="human.AppearanceSummary" Label="Appearance / visual profile" Lines="3" />
                </MudItem>
            }
            <MudItem xs="12">
                <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="() => RemoveHumanParticipant(human)" Style="margin-left: auto;">Remove</MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>
}

@code {
    [Parameter, EditorRequired] public RoomConfig Room { get; set; } = default!;
    [Parameter] public IReadOnlyList<string> KokoroVoices { get; set; } = [];
    [Parameter] public bool IsDark { get; set; }

    private void AddHumanParticipant()
    {
        Room.HumanParticipants.Add(new HumanParticipantConfig
        {
            RoomId = Room.Id,
            Name = $"Player {Room.HumanParticipants.Count + 1}",
            SortOrder = Room.HumanParticipants.Count,
            IsPlayerCharacter = true,
        });
    }

    private void RemoveHumanParticipant(HumanParticipantConfig human)
    {
        Room.HumanParticipants.Remove(human);
    }

    private static void OnHumanColorChanged(HumanParticipantConfig human, string accentHex)
    {
        human.AccentHex = accentHex;
        // Check both light and dark presets for the matching background
        var preset = AgentColorPresets.LightPresets.FirstOrDefault(p => p.AccentHex == accentHex)
                  ?? AgentColorPresets.DarkPresets.FirstOrDefault(p => p.AccentHex == accentHex);
        if (preset is not null)
            human.BackgroundHex = preset.BackgroundHex;
    }
}
