
@inject PromptLibraryState PromptLibraryState
@inject RoomInviteState RoomInviteState
@inject RoomState RoomState
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider


<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mt-4 mb-3 flex-wrap">
    <MudText Typo="Typo.h4">Agents</MudText>
    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@($"{Room.Agents.Count} agents total")</MudChip>
    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@($"{GetNpcCount(Room)} NPC")</MudChip>
</MudStack>

<MudText Typo="Typo.caption" Class="mb-3">
    Agents are AI chat bots in the room who take turns dialoging.<br />

    Human participants are named characters in the room who take turns alongside AI agents.
    When no human participants are defined, the local user speaks as "You" by default.
</MudText>
@if (!isNotRoomOwner)
{
    <br />
    <br />
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="mb-3 ml-2" OnClick="AddAiAgent" Disabled="@isNotRoomOwner">Add Agent</MudButton>

    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="mb-3 ml-2" OnClick="AddHumanParticipant" Disabled="@isNotRoomOwner">Add Human Participant</MudButton>

    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mb-3 ml-2" OnClick="InvitePlayer" Disabled="@isNotRoomOwner">Invite a Player!</MudButton>
}

@if (!isNotRoomOwner && RoomInviteState.RoomInvites.Count > 0)
{
    <br />
    <br />
    <MudDivider />
    <MudStack>
        <MudText Typo="Typo.h5">Current Invite Links</MudText>
        @foreach (var invite in RoomInviteState.RoomInvites)
        {
            <MudGrid Class="ml-4">
                <MudItem xs="6">
                    <MudText Typo="Typo.h6">@invite.Id
                        <MudIconButton Icon="@Icons.Material.Outlined.ContentCopy" OnClick="@(() => CopyToClipboard(invite.Id))" />
                    </MudText> 
                </MudItem>
                <MudItem xs="3">
                    <MudSpacer />
                </MudItem>
                <MudItem xs="3">
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="@(() => RevokeInvite(@invite.Id))">Revoke</MudButton>
                </MudItem>    
            </MudGrid>
        }
    </MudStack>
}
<br />
<br />
<MudDivider />

<MudExpansionPanels>
    <MudText Typo="Typo.h5">Your Room Agents</MudText>
@foreach (var agent in Room.Agents.OrderBy(x => x.SortOrder))
{
    <MudExpansionPanel>
            <TitleContent>
                <MudText Typo="Typo.h6">@agent.Name</MudText>
                <MudStack Row="true" Spacing="1" Class="mt-1">
                    @if (string.Equals(Room.PrivilegedAgentId, agent.Id, StringComparison.Ordinal))
                    {
                        <MudChip T="string" Color="Color.Primary" Size="Size.Small">Privileged</MudChip>
                    }
                    @if (agent.IsHumanParticipant)
                    {
                        <MudChip T="string" Color="Color.Secondary" Size="Size.Small">Human</MudChip>
                    }
                    @if (!agent.IsHumanParticipant && !agent.IsNpc)
                    {
                        <MudChip T="string" Color="Color.Secondary" Size="Size.Small">Agent</MudChip>
                    }
                    @if (agent.IsNpc)
                    {
                        <MudChip T="string" Color="Color.Secondary" Size="Size.Small">Temporary NPC</MudChip>
                    }
                    @if (agent.IsTemporarilySuspended)
                    {
                        <MudChip T="string" Color="Color.Warning" Size="Size.Small">Suspended</MudChip>
                        <MudChip T="string" Color="Color.Default" Size="Size.Small">@GetSuspensionLabel(agent)</MudChip>
                    }
                </MudStack>
        </TitleContent>
        <ChildContent>
    <MudPaper Class="pa-3 mb-3" Elevation="0" Outlined="true">
        <MudGrid>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="agent.Name" Label="Agent Name" Disabled="@(isNotRoomOwner && agent.UserId != accessingUserId)"/>
                
                @if (agent.IsTemporarilySuspended && !string.IsNullOrWhiteSpace(agent.SuspensionReason))
                {
                    <MudText Typo="Typo.caption">@agent.SuspensionReason</MudText>
                }
            </MudItem>
            <MudItem xs="12" md="4">
                <MudText Typo="Typo.body1">Sort Order</MudText>
                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">

                    <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowUp"
                                   Disabled="@(IsFirst(agent) || isNotRoomOwner)"
                                   OnClick="@(() => MoveUp(agent))" />

                    <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown"
                                   Disabled="@(IsLast(agent) || isNotRoomOwner)"
                                   OnClick="@(() => MoveDown(agent))" />

                    <MudText Typo="Typo.body2">
                        @agent.SortOrder
                    </MudText>

                </MudStack>
            </MudItem>
            @if (!agent.IsHumanParticipant)
            {
                            @if (!isNotRoomOwner)
                            {
                                <MudItem xs="12" md="4">
                                    <MudSelect @bind-Value="agent.ModelId" Label="Model" Disabled="@(isNotRoomOwner && agent.UserId != accessingUserId)">
                                        @foreach (var model in Models)
                                        {
                                            <MudSelectItem T="string" Value="@model.Id">@model.Name</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                            }
                            <MudItem xs="12">
                                <MudTextField @bind-Value="agent.SystemPrompt" Label="System Prompt" Lines="12" Disabled="@(isNotRoomOwner && agent.UserId != accessingUserId)" />
                            </MudItem>
                            @if (!isNotRoomOwner)
                            {
                                <MudItem xs="12">
                                    <MudPaper Class="pa-3 mb-2" Elevation="0" Outlined="true">
                                        <MudText Typo="Typo.subtitle2" Class="mb-2">Prompt Library</MudText>
                                        @if (OrderedPromptSamples.Count == 0)
                                        {
                                            <MudAlert Severity="Severity.Info" Dense="true">
                                                No prompt samples are available yet.
                                            </MudAlert>
                                        }
                                        else
                                        {
                                            <MudGrid>
                                                <MudItem xs="12" md="7">
                                                    <MudSelect T="int" @bind-Value="agent.PromptSampleId" Label="Library Prompt" Disabled="@(isNotRoomOwner && agent.UserId != accessingUserId)">

                                                        @foreach (var sample in OrderedPromptSamples)
                                                        {
                                                            <MudSelectItem T="int" Value="@sample.Id">
                                                                @sample.Name
                                                            </MudSelectItem>
                                                        }
                                                    </MudSelect>
                                                </MudItem>
                                            </MudGrid>
                                        }
                                    </MudPaper>
                                </MudItem>
                            }
                        }
            @if (Room.EnableSceneImageGeneration && Room.UseCreativeImageGeneration)
            {
                    <MudItem xs="12">
                        <MudTextField @bind-Value="agent.AppearanceSummary" Label="Appearance / visual profile" Lines="4" Disabled="@(isNotRoomOwner && agent.UserId != accessingUserId)" />
                    </MudItem>
            }
            @if (!agent.IsHumanParticipant)
            {
                <MudItem xs="12">
                    <MudSwitch @bind-Value="agent.IsEnabled" Label="Enabled" Color="Color.Primary" Disabled="@(isNotRoomOwner && agent.UserId != accessingUserId)" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudNumericField @bind-Value="agent.MaxTokensOverride" Label="Max tokens override" Disabled="@(isNotRoomOwner && agent.UserId != accessingUserId)" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudNumericField @bind-Value="agent.CompactionBudget" Label="Compaction budget" Min="80" Disabled="@(isNotRoomOwner && agent.UserId != accessingUserId)" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudSwitch @bind-Value="agent.UseShortTermMemoryStorage" Label="Use short-term memory" Color="Color.Primary" Disabled="@(isNotRoomOwner && agent.UserId != accessingUserId)" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudSwitch @bind-Value="agent.UseLongTermMemoryStorage" Label="Use long-term memory" Color="Color.Primary" Disabled="@(isNotRoomOwner && agent.UserId != accessingUserId)" />
                </MudItem>
            }
            


            <MudItem xs="12" md="3">
                @if (KokoroVoices.Count > 0)
                {
                    <MudSelect @bind-Value="agent.TtsVoice" Label="TTS Voice" ShrinkLabel="true" T="string" Disabled="@(isNotRoomOwner && agent.UserId != accessingUserId)">
                        <MudSelectItem T="string" Value="@string.Empty">(Default)</MudSelectItem>
                        @foreach (var voice in KokoroVoices)
                        {
                            <MudSelectItem T="string" Value="@voice">@voice</MudSelectItem>
                        }
                    </MudSelect>
                }
                else
                {
                    <MudTextField @bind-Value="agent.TtsVoice" Label="TTS Voice" Disabled="@(isNotRoomOwner && agent.UserId != accessingUserId)" />
                }
            </MudItem>
            <MudItem xs="12" md="3">
                <MudButton Variant="Variant.Outlined"
                           Size="Size.Small"
                           Class="mt-4"
                           OnClick="@(() => OnTestAgentVoice.InvokeAsync(agent))"
                           Disabled="@(IsPreviewingVoice || isNotRoomOwner && agent.UserId != accessingUserId)">
                    @(PreviewAgentId == agent.Id ? "Playing..." : "Test Voice")
                </MudButton>
            </MudItem>
            <MudItem xs="12">
                <MudText></MudText>
            </MudItem>

            <MudItem xs="12" md="3">
                <MudSelect T="AgentColorPresets.ColorPreset"
                           Value="GetSelectedPreset(agent)"
                           ValueChanged="@(preset => OnPresetChanged(agent, preset))"
                           ToStringFunc="p => p?.Name ?? string.Empty"
                           Label="Chat Color"
                           Disabled="@(isNotRoomOwner && agent.UserId != accessingUserId)">

                    @foreach (var preset in AgentColorPresets.GetPresets(IsDark))
                    {
                        <MudSelectItem Value="@preset">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.Circle"
                                         Style="@($"color:{preset.AccentHex}")"
                                         Size="Size.Small" />
                                @preset.Name
                            </MudStack>
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="() => RemoveAgent(agent)" style="margin-left: auto;" Disabled="@(isNotRoomOwner && agent.UserId != accessingUserId)">Remove</MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>
            </ChildContent>
</MudExpansionPanel>
}
</MudExpansionPanels>

    @code {
    [Parameter, EditorRequired] public RoomConfig Room { get; set; } = default!;
    [Parameter] public IReadOnlyList<AiModel> Models { get; set; } = [];
    [Parameter] public IReadOnlyList<string> KokoroVoices { get; set; } = [];
    [Parameter] public bool IsDark { get; set; }
    [Parameter] public bool IsPreviewingVoice { get; set; }
    [Parameter] public string PreviewAgentId { get; set; } = string.Empty;
    [Parameter] public EventCallback<AgentConfig> OnTestAgentVoice { get; set; }

    private string redeemCode = string.Empty;
    private bool isNotRoomOwner = false;
    private string accessingUserId = string.Empty;
    public ClaimsPrincipal user;

    //OLD
    private List<PromptSample> OrderedPromptSamples => PromptLibraryState.Samples
    .OrderByDescending(s => s.IsBuiltIn)
        .ThenBy(s => s.SortOrder)
        .ThenBy(s => s.Name)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        if (!PromptLibraryState.IsLoaded)
            await PromptLibraryState.LoadAsync();
        await RoomInviteState.LoadAsync(Room.Id);

        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        user = state.User;
        accessingUserId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        isNotRoomOwner = RoomState.SelectedRoom?.UserId != accessingUserId;
    }

    private string? _loadedInviteRoomId;

    protected override async Task OnParametersSetAsync()
    {
        accessingUserId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
        isNotRoomOwner = Room.UserId != accessingUserId;

        if (!isNotRoomOwner && !string.Equals(_loadedInviteRoomId, Room.Id, StringComparison.Ordinal))
        {
            _loadedInviteRoomId = Room.Id;
            await RoomInviteState.LoadAsync(Room.Id);
        }
    }


    protected override void OnParametersSet()
    {
        var validAgentIds = Room.Agents.Select(a => a.Id).ToHashSet(StringComparer.Ordinal);
    }

    private void AddAiAgent() => AddAgent(isHumanParticipant: false);
    private void AddHumanParticipant() => AddAgent(isHumanParticipant: true);
    private void AddAgent(bool isHumanParticipant)
    {
        Random r = new Random();
        var randomColor = AgentColorPresets.GetPresets(IsDark).ToArray()[r.Next(0, AgentColorPresets.LightPresets.Count())];
        Room.Agents.Add(new AgentConfig
        {
            RoomId = Room.Id,
            Name = isHumanParticipant ? $"Player {Room.Agents.Where(x => x.IsHumanParticipant).Count() + 1}" : $"Agent {Room.Agents.Where(x => !x.IsHumanParticipant).Count() + 1}",
            SortOrder = Room.Agents.Count,
            IsHumanParticipant = isHumanParticipant,
            UserId = isHumanParticipant ? accessingUserId : null,
            UseShortTermMemoryStorage = !isHumanParticipant,
            UseLongTermMemoryStorage = !isHumanParticipant,
            ColorTheme = randomColor.Name
        });
    }

    private async Task InvitePlayer()
    {
        await RoomInviteState.CreateAsync(Room.Id);
        StateHasChanged();
    }
    private async Task CopyToClipboard(Guid id)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", id);
    }


    private async Task RevokeInvite(Guid id)
    {
        await RoomInviteState.RevokeAsync(id, Room.Id);
        StateHasChanged();
    }

    private void RemoveAgent(AgentConfig agent)
    {
        if (string.Equals(Room.PrivilegedAgentId, agent.Id, StringComparison.Ordinal))
            Room.PrivilegedAgentId = string.Empty;

        Room.Agents.Remove(agent);

    }

    private void OnAgentColorChanged(AgentConfig agent, string colorTheme)
    {
        var preset = AgentColorPresets.FindByName(colorTheme, IsDark);
        agent.ColorTheme = preset.Name;
    }

    private static int GetEnabledAgentCount(RoomConfig room) =>
        room.Agents.Count(a => a.IsEnabled);

    private static int GetNpcCount(RoomConfig room) =>
        room.Agents.Count(a => a.IsNpc);

    private static string GetSuspensionLabel(AgentConfig agent) =>
        agent.SuspendedUntilRound.HasValue ? $"Until round {agent.SuspendedUntilRound.Value}" : "Until resumed";

    private List<AgentConfig> OrderedAgents =>
    Room.Agents.OrderBy(x => x.SortOrder).ToList();

    private bool IsFirst(AgentConfig agent) =>
        OrderedAgents.First().SortOrder == agent.SortOrder;

    private bool IsLast(AgentConfig agent) =>
        OrderedAgents.Last().SortOrder == agent.SortOrder;

    private AgentColorPresets.ColorPreset? GetSelectedPreset(AgentConfig agent)
    {
        return AgentColorPresets.GetPresets(IsDark)
            .FirstOrDefault(x => x.Name == agent.ColorTheme);
    }

    private void MoveUp(AgentConfig agent)
    {
        var list = OrderedAgents;
        var index = list.IndexOf(agent);

        if (index <= 0)
            return;

        Swap(list, index, index - 1);
        ReassignSortOrder(list);
    }

    private void MoveDown(AgentConfig agent)
    {
        var list = OrderedAgents;
        var index = list.IndexOf(agent);

        if (index >= list.Count - 1)
            return;

        Swap(list, index, index + 1);
        ReassignSortOrder(list);
    }

    private void Swap(List<AgentConfig> list, int i, int j)
    {
        (list[i], list[j]) = (list[j], list[i]);
    }

    private void ReassignSortOrder(List<AgentConfig> list)
    {
        for (int i = 0; i < list.Count; i++)
            list[i].SortOrder = i;
    }

    private void OnPresetChanged(
    AgentConfig agent,
    AgentColorPresets.ColorPreset? preset)
    {
        if (preset is null)
            return;

        agent.ColorTheme = preset.Name;
        OnAgentColorChanged(agent, preset.Name);
    }

    
}