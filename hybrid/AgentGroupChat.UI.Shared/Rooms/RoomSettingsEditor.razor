@inject RoomState RoomState
@inject AppState AppState
@inject AgentGroupChat.Core.Services.SpeechService Speech
@inject PromptLibraryState PromptLibraryState
@using System.Security.Claims
@using AgentGroupChat.Core.Services
@using static AgentGroupChat.Core.TtsProviders
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider


<MudText Typo="Typo.h4" Class="mt-4 mb-2">
    Basics
</MudText>
<MudItem Class="ml-4">
    <MudText Typo="Typo.caption" Class="mb-2">
        These settings control room-specific behavior for your agents, and the overall quality and cadence of conversation.
    </MudText>
    <MudTextField @bind-Value="Room.Name" Label="Name" Class="mb-2" Disabled="@isNotRoomOwner"/>
    <MudTextField @bind-Value="Room.Topic" Label="Topic" Lines="3" Class="mb-2" Disabled="@isNotRoomOwner" />
</MudItem>
<br />
<br />
<MudExpansionPanels>
    <MudExpansionPanel>
        <TitleContent>
            <MudText Typo="Typo.h5">Turn Flow</MudText>
        </TitleContent>
        <ChildContent>
            <MudSwitch @bind-Value="Room.WaitForUserReply" Label="Wait for Room Owner" Color="Color.Primary" Disabled="@isNotRoomOwner"/>

            <MudItem Class="ml-4">
                <MudText Typo="Typo.body1" Class="mb-2">
                    If enabled, the room will pause after each round of agent replies, waiting for the user/room owner to click "Continue" or send another message before proceeding.
                    If disabled, the room will still pause based on the amount of 'Rounds' configured in the Chat tab, but can be run by any other users.
                </MudText>

                @if (Room.WaitForUserReply)
                {
                    <MudItem Class="ml-4">
                        <MudRadioGroup @bind-Value="Room.PauseAfterEveryReply" Class="mb-2" Disabled="@isNotRoomOwner">
                        <MudRadio Value="false" Color="Color.Primary" T="bool">Pause at end of round</MudRadio>
                        <MudRadio Value="true" Color="Color.Primary" T="bool">Pause after every agent reply</MudRadio>
                    </MudRadioGroup>
                    </MudItem>
                }
                <br />
                <MudGrid>
                    <MudItem xs="6">
                        <MudNumericField @bind-Value="Room.AgentDelaySeconds" Label="Seconds between agents" Min="1" Disabled="@isNotRoomOwner" />
                        <MudText Typo="Typo.body1">
                            This adds a delay between each agent's turn within a single round.<br />
                            Raise this number to prevent throttling or rate limit issues with your AI provider, 
                            especially if agents are using the same model. 
                        </MudText>
                    </MudItem>
                    @*
                    I am temporarily disabling this as we attempt to move to agent-specific max token settings
                    Instead of allowing freeform "recent transcript turns, it seems easier to just set the recent transcripts sent equal to the number of players in the room"
                    <MudItem xs="6"> 
                        <MudNumericField @bind-Value="Room.MaxTokens" Label="Max tokens" Min="50" />
                        <MudText Typo="Typo.body1">
                            This is the maximum number of tokens that an agent's reply can contain before being cut off. <br />
                            Set this according to the typical length of replies you want, and the limits of your AI provider.<br />
                            Warning: may truncate replies if set too low.
                        </MudText>
                    </MudItem>
                    <br />
                    <MudItem xs="6"> 
                        <MudNumericField @bind-Value="Room.RecentTurnsWindow" Label="Recent transcript turns" Min="1" />
                        <MudText Typo="Typo.body1">
                            How many agent/user replies are included as token context for each agent request.<br />
                            Set this to the same number of agents in the room as a starting point.<br />
                            This does not affect the summarizer agents transcript window.
                        </MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudNumericField @bind-Value="Room.UserCompactionBudget" Label="User compaction budget" Min="200" />
                        <MudText Typo="Typo.body1">
                            How many tokens, agent requests will be compacted to when context is high.
                        </MudText>
                    </MudItem> *@
                </MudGrid>
            </MudItem>
        </ChildContent>
    </MudExpansionPanel>
    <MudExpansionPanel>
        <TitleContent>
            <MudText Typo="Typo.h5">Summarizer</MudText>
        </TitleContent>
        <ChildContent>
            <ul class="ml-4" style="list-style-type: none;">
                <li>
                    The summarizer is the agent that runs after the last agent replies in every round.
                </li>
                <li>
                    The summarizer stores the conversation history and feeds it back to the agents as context.<br />
                    It has a big impact on the quality of the conversation and how well agents can remember 
                    and refer back to previous interactions.
                </li>
                <li>
                    Longer running conversations with many agents may require a fine tuned custom summarizer.
                </li>
            </ul>
            <br />

            <MudSwitch @bind-Value="Room.UseSummarizer" Label="Enable the memory summarizer agent" Color="Color.Primary" T="bool" Disabled="@isNotRoomOwner" />
            @if (Room.UseSummarizer)
            {
                <MudSwitch @bind-Value="Room.StoreSharedRoomMemory" Label="Enable Shared Room Memory" Color="Color.Primary" T="bool" Disabled="@isNotRoomOwner" />
                <MudSwitch @bind-Value="Room.StoreDurableMemory" Label="Enable Durable Memory" Color="Color.Primary" T="bool" Disabled="@isNotRoomOwner" />
                <MudSwitch @bind-Value="Room.StoreLongTermArchives" Label="Enable Long Term Archival" Color="Color.Primary" T="bool" Disabled="@isNotRoomOwner" />

                <MudItem Class="ml-4">
                    <MudSelect @bind-Value="Room.SummarizerModelId" Label="Summarizer Model" ShrinkLabel="true" Class="mb-2" Disabled="@isNotRoomOwner">
                        <MudSelectItem T="string" Value="@string.Empty">(Use global default)</MudSelectItem>
                        @foreach (var model in Models)
                        {
                            <MudSelectItem T="string" Value="@model.Id">@model.Name</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect @bind-Value="Room.SummarizationLevel" Label="Compression Level" Class="mb-2" Disabled="@isNotRoomOwner">
                        <MudSelectItem T="string" Value="@("Aggressive")">Aggressive</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Semi-Aggressive")">Semi-Aggressive</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Moderate")">Moderate</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Semi-Relaxed")">Semi-Relaxed</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Relaxed")">Relaxed</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Custom")">Custom</MudSelectItem>
                    </MudSelect>
                    <MudText Typo="Typo.body1" Class="mb-2">
                        <ul class="ml-4" style="list-style-type: none;">
                            <li>
                                Aggressive summarization may lead to loss of important details.
                            </li>
                            <li> 
                                Relaxed summarization may cause context overflow and increased token usage.
                            </li>
                        </ul>
                    </MudText>
                    @if (Room.SummarizationLevel == "Custom")
                    {
                        <MudGrid>
                            <MudItem xs="6">
                                <MudNumericField @bind-Value="Room.SummarizerMaxTokens" Label="Summarizer max tokens" Min="140" Disabled="@isNotRoomOwner" />
                                <MudText Typo="Typo.body1" Class="ml-4">
                                    The maximum number of tokens that an agent's summary can contain before being cut off. <br />
                                    Set this according to the typical length of replies you want, and the limits of your AI provider.
                                    Warning: may truncate replies if set too low.
                                </MudText>
                            </MudItem>
                            <MudItem xs="6">
                                <MudNumericField @bind-Value="Room.SummarizerMaxLines" Label="Summarizer max lines" Min="12" Disabled="@isNotRoomOwner" />
                                <MudText Typo="Typo.body1" Class="ml-4">
                                    The maximum number of lines that an agent's summary can generate. <br />
                                    Additional guardrail to prevent runaway token usage, since summaries can get very verbose.
                                    Warning: may truncate replies if set too low.
                                </MudText>
                            </MudItem>

                            <br />
                            <MudItem xs="6">
                                <MudNumericField @bind-Value="Room.SummarizerMaxCharacters" Label="Summarizer max characters" Min="1800" Disabled="@isNotRoomOwner" />
                                <MudText Typo="Typo.body1" Class="ml-4">
                                    The maximum number of characters that an agent's summary can contain before being cut off. <br />
                                    Additional guardrail to prevent runaway token usage, since summaries can get very verbose.
                                    Warning: may truncate replies if set too low.
                                </MudText>
                            </MudItem>

                            @* <MudItem xs="6">
                            <MudNumericField @bind-Value="Room.SummarizerBroaderTurns" Label="Broader transcript turns" Min="1" />
                            <MudText Typo="Typo.body1" Class="ml-4">
                                    How many agent/user messages are included as token context for each agent to summarize.<br />
                                Set as 2 to 3 times the number of agents in the room as a starting point.
                            </MudText>
                        </MudItem> *@

                        </MudGrid>
                        <br />
                        <MudItem xs="12">
                            <MudPaper Class="pa-3 mb-2" Elevation="0" Outlined="true">
                                <MudText Typo="Typo.subtitle2" Class="mb-2">Prompt Library</MudText>
                                @if (OrderedPromptSamples.Count == 0)
                                {
                                    <MudAlert Severity="Severity.Info" Dense="true">
                                        No prompt samples are available yet.
                                    </MudAlert>
                                }
                                else
                                {
                                    <MudGrid>
                                        <MudItem xs="6">
                                            <MudSelect T="int" @bind-Value="Room.SharedRoomMemoryPromptSampleId" Label="Shared Room Memory Prompt" Disabled="@isNotRoomOwner">

                                                @foreach (var sample in OrderedPromptSamples)
                                                {
                                                    <MudSelectItem T="int" Value="@sample.Id">
                                                        @sample.Name
                                                    </MudSelectItem>
                                                }
                                            </MudSelect>
                                        </MudItem>
                                        <MudItem xs="6">
                                            <MudSelect T="int" @bind-Value="Room.DurableMemoryPromptSampleId" Label="Durable Memory Prompt" Disabled="@isNotRoomOwner">

                                                @foreach (var sample in OrderedPromptSamples)
                                                {
                                                    <MudSelectItem T="int" Value="@sample.Id">
                                                        @sample.Name
                                                    </MudSelectItem>
                                                }
                                            </MudSelect>
                                        </MudItem>
                                    </MudGrid>
                                }
                            </MudPaper>
                        </MudItem>
                    }
                </MudItem>
            }
        </ChildContent>
    </MudExpansionPanel>
    <MudExpansionPanel>
        <TitleContent>
            <MudText Typo="Typo.h5">Speech</MudText>
        </TitleContent>
        <ChildContent>
            <MudItem Class="ml-4">
                <MudText Typo="Typo.body1" Class="mb-2">
                    Keep speech behavior with the room instead of the Chat page. Rate and live pause or resume still stay in Chat, but the room now controls whether speech is on, which provider it uses, the room-wide fallback voice, and your own voice.
                </MudText>
                <MudSwitch Value="@GetResolvedSpeechEnabled()" Label="Enable speech in this room" Color="Color.Primary" T="bool" ValueChanged="OnSpeechEnabledChanged" Disabled="@isNotRoomOwner" />
                @if (Room.TtsEnabledOverride.HasValue && Room.TtsEnabledOverride == true)
                {
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudSelect Value="@Room.TtsProviderOverride" Label="Speech provider" ShrinkLabel="true" T="string" ValueChanged="OnSpeechProviderChanged" Disabled="@isNotRoomOwner">
                                <MudSelectItem T="string" Value="@string.Empty">(Use app default: @AppState.Settings.TtsProvider)</MudSelectItem>
                                <MudSelectItem T="string" Value="@(Local)">Local</MudSelectItem>
                                <MudSelectItem T="string" Value="@(Piper)">Piper</MudSelectItem>
                                <MudSelectItem T="string" Value="@(Kokoro)">Kokoro</MudSelectItem>
                            </MudSelect>
                            <MudText Typo="Typo.body1">
                                Technical provider config such as Kokoro's base URL or Piper's executable path still uses the app-level settings store. This room decides which provider to use and which voices it should prefer.
                            </MudText>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2">
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="TestSpeechProviderAsync" Disabled="_testingSpeech || isNotRoomOwner">
                                    @(_testingSpeech ? "Testing..." : "Test Provider")
                                </MudButton>
                                @if (UsesKokoro())
                                {
                                    <MudButton Variant="Variant.Outlined" OnClick="RefreshVoicesAsync" Disabled="_testingSpeech || isNotRoomOwner">Refresh Voices</MudButton>
                                }
                                @if (_canStartKokoroService)
                                {
                                    <MudButton Variant="Variant.Outlined" Color="Color.Warning" OnClick="StartKokoroService" Disabled="@isNotRoomOwner">Start Service</MudButton>
                                }
                            </MudStack>
                            @if (!string.IsNullOrWhiteSpace(_speechTestResult))
                            {
                                <MudText Typo="Typo.caption" Color="@(_speechTestOk ? Color.Success : Color.Error)">@_speechTestResult</MudText>
                            }
                        </MudItem>
                        <MudItem xs="12" md="6">
                            @if (UsesKokoro() && _kokoroVoices.Count > 0)
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
                                    <MudSelect @bind-Value="Room.TtsFallbackVoice" Label="Room fallback voice" ShrinkLabel="true" T="string" Style="flex:1;" Disabled="@isNotRoomOwner">
                                        <MudSelectItem T="string" Value="@string.Empty">(Use app default)</MudSelectItem>
                                        @foreach (var voice in _kokoroVoices)
                                        {
                                            <MudSelectItem T="string" Value="@voice">@voice</MudSelectItem>
                                        }
                                    </MudSelect>
                                    <MudButton Variant="Variant.Outlined" Class="mt-3" OnClick="TestFallbackVoiceAsync" Disabled="_previewingFallbackVoice || _testingSpeech || isNotRoomOwner">
                                        @(_previewingFallbackVoice ? "Playing..." : "Test")
                                    </MudButton>
                                </MudStack>
                            }
                            else
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
                                    <MudTextField @bind-Value="Room.TtsFallbackVoice" Label="Room fallback voice" Style="flex:1;" Disabled="@isNotRoomOwner" />
                                    <MudButton Variant="Variant.Outlined" Class="mt-3" OnClick="TestFallbackVoiceAsync" Disabled="_previewingFallbackVoice || _testingSpeech || isNotRoomOwner">
                                        @(_previewingFallbackVoice ? "Playing..." : "Test")
                                    </MudButton>
                                </MudStack>
                            }
                            <MudText Typo="Typo.body1">
                                This is the default voice the room falls back to when an agent does not have its own voice override.
                            </MudText>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            @if (UsesKokoro() && _kokoroVoices.Count > 0)
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
                                    <MudSelect @bind-Value="Room.TtsUserVoice" Label="Your voice" ShrinkLabel="true" T="string" Style="flex:1;" Disabled="@isNotRoomOwner">
                                        <MudSelectItem T="string" Value="@string.Empty">(Use room fallback)</MudSelectItem>
                                        @foreach (var voice in _kokoroVoices)
                                        {
                                            <MudSelectItem T="string" Value="@voice">@voice</MudSelectItem>
                                        }
                                    </MudSelect>
                                    <MudButton Variant="Variant.Outlined" Class="mt-3" OnClick="TestUserVoiceAsync" Disabled="_previewingUserVoice || _testingSpeech || isNotRoomOwner">
                                        @(_previewingUserVoice ? "Playing..." : "Test")
                                    </MudButton>
                                </MudStack>
                            }
                            else
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
                                    <MudTextField @bind-Value="Room.TtsUserVoice" Label="Your voice" Style="flex:1;" Disabled="@isNotRoomOwner" />
                                    <MudButton Variant="Variant.Outlined" Class="mt-3" OnClick="TestUserVoiceAsync" Disabled="_previewingUserVoice || _testingSpeech || isNotRoomOwner">
                                        @(_previewingUserVoice ? "Playing..." : "Test")
                                    </MudButton>
                                </MudStack>
                            }
                            <MudText Typo="Typo.body1">
                                If this is blank, your messages use the room fallback voice instead.
                            </MudText>
                        </MudItem>
                    </MudGrid>
                }
            </MudItem>
        </ChildContent>
    </MudExpansionPanel>
    <MudExpansionPanel>
        <TitleContent>
            <MudText Typo="Typo.h5">Scene Images</MudText>
        </TitleContent>
        <ChildContent>
            <MudItem Class="ml-4">
            <MudSwitch @bind-Value="Room.EnableSceneImageGeneration" Label="Enable Scene Image Generation" Color="Color.Primary" Disabled="@isNotRoomOwner" />
            <MudText Typo="Typo.body1" Class="mb-2 ml-8">
                You must have ComfyUI or another image generation service set up.
                When enabled, the app can use room and agent context to support manual scene image generation workflows.<br />
                Configure providers and run test generations from AI Models > Image, then choose the default image model for this room here.
            </MudText>
            @if (Room.EnableSceneImageGeneration)
            {
                @if (ImageModels.Count > 0)
                {
                        <MudSelect @bind-Value="Room.SceneImageModelId" Label="Default image model" ShrinkLabel="true" Class="mb-2" Disabled="@isNotRoomOwner">
                        <MudSelectItem T="string" Value="@string.Empty">(No room override)</MudSelectItem>
                        @foreach (var imageModel in ImageModels)
                        {
                            <MudSelectItem T="string" Value="@imageModel.Id">@imageModel.Name</MudSelectItem>
                        }
                    </MudSelect>
                }
                else
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                        No image models are configured yet. Add them under AI Models > Image to enable provider tests and room defaults.
                    </MudAlert>
                }
                <MudSwitch @bind-Value="Room.UseCreativeImageGeneration"
                       Label="Use for creative image generation"
                       Color="Color.Primary"
                       Disabled="@(!Room.EnableSceneImageGeneration || isNotRoomOwner)" />
                <MudText Typo="Typo.body1" Class="mb-2  ml-8">
                    Turning this on displays appearance text boxes for each agent, which is mainly used for creative, role-playing, and scene-image workflows.
                </MudText>
                    <MudTextField @bind-Value="Room.SceneImageStyleNotes" Label="Style notes" Lines="4" Class="mb-2" Disabled="@isNotRoomOwner" />
                <MudText Typo="Typo.body1" Class="mb-2  ml-8">
                     How you want the image generation agent to render scene images, 
                     such as art style, color palette, or composition notes.
                </MudText>
                    <MudTextField @bind-Value="Room.SceneImageNegativePrompt" Label="Negative prompt / exclusions" Lines="4" Disabled="@isNotRoomOwner" />
                <MudText Typo="Typo.body1" Class="mb-2  ml-8">
                    Specific things you want the image generation agent to avoid when rendering scene images, 
                    such as "blurry", "low quality", or specific elements or colors.
                </MudText>
            }
            </MudItem>

        </ChildContent>
    </MudExpansionPanel>
    <MudExpansionPanel>
        <TitleContent>
            <MudText Typo="Typo.h5">Privileged Actions</MudText>
        </TitleContent>
        <ChildContent>
            <MudItem Class="ml-4">
            <MudText Typo="Typo.body1" Class="mb-2">
                Enabling privileged actions allows one agent in the room to perform special functions.<br />
                This feature is especially useful for scenarios where you want a specific agent to have enhanced capabilities, 
                such as spawning temporary agents to participate in the chat, as well as suspending long-term agents.<br />
                The privileged agent should be the last enabled permanent agent in turn order for best results.
                </MudText>
                <MudSwitch @bind-Value="Room.EnablePrivilegedActions" Label="Enable Privileged Actions" Color="Color.Primary" Disabled="@isNotRoomOwner" />
            @if (Room.EnablePrivilegedActions)
            {
                    <MudSelect @bind-Value="Room.PrivilegedAgentId" Label="Privileged Agent" ShrinkLabel="true" Class="mb-2 ml-8 mr-8" T="string" Disabled="@isNotRoomOwner">
                    <MudSelectItem T="string" Value="@string.Empty">(Select agent)</MudSelectItem>
                    @foreach (var privilegedAgent in GetPermanentAgents(Room))
                    {
                        <MudSelectItem T="string" Value="@privilegedAgent.Id">@privilegedAgent.Name</MudSelectItem>
                    }
                </MudSelect>

                <MudSwitch @bind-Value="Room.EnableNpcSpawning" Label="Generate Temporary Agents" Color="Color.Primary" Disabled="@isNotRoomOwner" />
                <MudItem Class="ml-8">
                @if (Room.EnableNpcSpawning)
                {
                    <MudGrid Class="mt-2">
                        <MudItem xs="6">
                            <MudSelect @bind-Value="Room.NpcModelId" Label="NPC Model" ShrinkLabel="true" T="string" Disabled="@isNotRoomOwner">
                                <MudSelectItem T="string" Value="@string.Empty">(Use privileged agent model)</MudSelectItem>
                                @foreach (var model in Models)
                                {
                                    <MudSelectItem T="string" Value="@model.Id">@model.Name</MudSelectItem>
                                }
                            </MudSelect>
                            <MudText Typo="Typo.body1">
                                The AI model that will be used for any temporary agents spawned in this room. 
                                If not set, will use the same model as the privileged agent.
                            </MudText>
                        </MudItem>
                        <MudItem xs="6">
                            <MudNumericField @bind-Value="Room.MaxConcurrentNpcs" Label="Max concurrent NPCs" Min="1" Max="4" Disabled="@isNotRoomOwner" />
                            <MudText Typo="Typo.body1">Active NPCs: @GetActiveNpcCount(Room) / @Math.Max(1, Room.MaxConcurrentNpcs)</MudText>
                
                        </MudItem>
                        <MudItem xs="6">
                            <MudNumericField @bind-Value="Room.NpcMaxTokens" Label="NPC max tokens" Min="50" Disabled="@isNotRoomOwner" />
                            <MudText Typo="Typo.body1">
                                The maximum number of tokens that an NPC agent's reply can contain before being cut off. 
                                Set this according to the typical length of replies you want, and the limits of your AI provider.
                                Warning: may truncate replies if set too low.
                            </MudText>
                        </MudItem>
                        <MudItem xs="6">
                            <MudNumericField @bind-Value="Room.NpcCompactionBudget" Label="NPC compaction budget" Min="80" Disabled="@isNotRoomOwner" />
                            <MudText Typo="Typo.body1">
                                How many tokens an agent requests will be compacted to when context & memory is high.
                            </MudText>
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="Room.NpcBaseInstructions" Label="NPC agent instructions" Lines="6" Disabled="@isNotRoomOwner" />
                            <MudText Typo="Typo.body1">
                                Additional instructional text to send the NPC in addition to the selected template, if defined.
                             </MudText>
                        </MudItem>
                        <MudItem xs="6">
                                    <MudSelect T="int" @bind-Value="Room.NpcPromptSampleId" Label="NPC Prompt Template" Disabled="@isNotRoomOwner">
                                @foreach (var sample in OrderedPromptSamples)
                                {
                                    <MudSelectItem T="int" Value="@sample.Id">
                                        @sample.Name
                                    </MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12">
                            <MudText Typo="Typo.body1">
                                Spawned NPC voices are assigned automatically. When Kokoro speech is active, male and female temporary agents will pick a gender-matched voice automatically; otherwise they fall back to the current default voice.
                            </MudText>
                        </MudItem>
                    </MudGrid>
                }
                </MudItem>
            }

            </MudItem>
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>

@code {
    private const string SpeechPreviewSample = "Testing speech for this room.";

    [Parameter, EditorRequired] public RoomConfig Room { get; set; } = default!;
    [Parameter] public IReadOnlyList<AiModel> Models { get; set; } = [];
    [Parameter] public IReadOnlyList<ImageModel> ImageModels { get; set; } = [];
    [Parameter] public Func<Task>? OnSpeechSettingsChanged { get; set; }

    private List<string> _kokoroVoices = [];
    private string _loadedSpeechProvider = string.Empty;
    private bool _testingSpeech;
    private bool _speechTestOk;
    private bool _canStartKokoroService;
    private string _speechTestResult = string.Empty;
    private bool _previewingFallbackVoice;
    private bool _previewingUserVoice;
    private bool isNotRoomOwner = false;
    public string accessingUserId = "";
    public ClaimsPrincipal user;

    private List<PromptSample> OrderedPromptSamples => PromptLibraryState.Samples
    .OrderByDescending(s => s.IsBuiltIn)
    .ThenBy(s => s.SortOrder)
    .ThenBy(s => s.Name)
    .ToList();

    protected override async Task OnInitializedAsync()
    {
        if (!PromptLibraryState.IsLoaded)
            await PromptLibraryState.LoadAsync();


        RoomState.OnChange += UpdateSelectedRoom;

        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        user = state.User;
        accessingUserId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        isNotRoomOwner = RoomState.SelectedRoom?.UserId != accessingUserId;
    }

    private void UpdateSelectedRoom()
    {
        accessingUserId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        isNotRoomOwner = RoomState.SelectedRoom?.UserId != accessingUserId;
        StateHasChanged();
    }
    protected override async Task OnParametersSetAsync()
    {
        var provider = GetResolvedSpeechProvider();
        if (string.Equals(_loadedSpeechProvider, provider, StringComparison.OrdinalIgnoreCase))
            return;

        _loadedSpeechProvider = provider;
        await RefreshVoicesAsync();
    }

    private static IEnumerable<AgentConfig> GetPermanentAgents(RoomConfig room) =>
        room.Agents.Where(a => !a.IsNpc).OrderBy(a => a.SortOrder);

    private static int GetActiveNpcCount(RoomConfig room) =>
        room.Agents.Count(a => a.IsEnabled && a.IsNpc);

    private static bool IsPrivilegedAgentLast(RoomConfig room)
    {
        if (!room.EnablePrivilegedActions || string.IsNullOrWhiteSpace(room.PrivilegedAgentId))
            return true;

        var enabledPermanentAgents = room.Agents
            .Where(a => a.IsEnabled && !a.IsNpc)
            .OrderBy(a => a.SortOrder)
            .ToList();

        return enabledPermanentAgents.Count == 0
            || string.Equals(enabledPermanentAgents[^1].Id, room.PrivilegedAgentId, StringComparison.Ordinal);
    }

    private bool GetResolvedSpeechEnabled() => RoomSpeechResolver.IsSpeechEnabled(Room, AppState.Settings);

    private Task OnSpeechEnabledChanged(bool enabled)
    {
        Room.TtsEnabledOverride = enabled;
        return NotifySpeechSettingsChangedAsync();
    }

    private string GetResolvedSpeechProvider() => RoomSpeechResolver.GetProvider(Room, AppState.Settings);

    private async Task OnSpeechProviderChanged(string provider)
    {
        Room.TtsProviderOverride = provider;
        _loadedSpeechProvider = GetResolvedSpeechProvider();
        await RefreshVoicesAsync();
        await NotifySpeechSettingsChangedAsync();
    }

    private bool UsesKokoro() => RoomSpeechResolver.UsesKokoro(Room, AppState.Settings);

    private string GetResolvedFallbackVoice() => RoomSpeechResolver.GetFallbackVoice(Room, AppState.Settings);

    private string GetResolvedUserVoice() => RoomSpeechResolver.GetUserVoice(Room, AppState.Settings);

    private SpeechService.SpeechSettings BuildSpeechSettings(bool forceEnabled = false) =>
        RoomSpeechResolver.BuildSettings(Room, AppState.Settings, forceEnabled);

    private async Task RefreshVoicesAsync()
    {
        if (!UsesKokoro())
        {
            _kokoroVoices.Clear();
            await InvokeAsync(StateHasChanged);
            return;
        }

        var voices = await Speech.FetchKokoroVoicesAsync(AppState.Settings.KokoroBaseUrl);
        _kokoroVoices = voices.ToList();
        await InvokeAsync(StateHasChanged);
    }

    private async Task TestSpeechProviderAsync()
    {
        if (_testingSpeech)
            return;

        _testingSpeech = true;
        _speechTestResult = string.Empty;
        _canStartKokoroService = false;
        StateHasChanged();

        try
        {
            var provider = GetResolvedSpeechProvider();
            if (string.Equals(provider, Kokoro, StringComparison.OrdinalIgnoreCase))
            {
                await TestKokoroConnectionAsync();
                return;
            }

            if (string.Equals(provider, Piper, StringComparison.OrdinalIgnoreCase)
                && (string.IsNullOrWhiteSpace(AppState.Settings.PiperExePath) || !File.Exists(AppState.Settings.PiperExePath)))
            {
                _speechTestOk = false;
                _speechTestResult = "Piper is selected, but the Piper executable path is not configured in app settings.";
                return;
            }

            var previewVoice = GetResolvedUserVoice();
            if (string.Equals(provider, Piper, StringComparison.OrdinalIgnoreCase) && string.IsNullOrWhiteSpace(previewVoice))
            {
                _speechTestOk = false;
                _speechTestResult = "Set a room fallback voice or your own voice before testing Piper playback.";
                return;
            }

            await Speech.SpeakAsync(BuildSpeechSettings(forceEnabled: true), SpeechPreviewSample, previewVoice, CancellationToken.None);
            _speechTestOk = true;
            _speechTestResult = $"Playing a {provider} test sample for this room.";
        }
        catch (Exception ex)
        {
            _speechTestOk = false;
            _speechTestResult = $"Speech test failed: {Truncate(ex.Message, 120)}";
        }
        finally
        {
            _testingSpeech = false;
            StateHasChanged();
        }
    }

    private async Task TestFallbackVoiceAsync() =>
        await PreviewVoiceAsync(GetResolvedFallbackVoice(), isUserPreview: false, "room fallback voice");

    private async Task TestUserVoiceAsync() =>
        await PreviewVoiceAsync(GetResolvedUserVoice(), isUserPreview: true, "your voice");

    private async Task PreviewVoiceAsync(string voice, bool isUserPreview, string label)
    {
        if (_testingSpeech)
            return;

        if (isUserPreview)
            _previewingUserVoice = true;
        else
            _previewingFallbackVoice = true;

        _speechTestResult = string.Empty;
        _canStartKokoroService = false;
        StateHasChanged();

        try
        {
            var provider = GetResolvedSpeechProvider();
            if (string.Equals(provider, Kokoro, StringComparison.OrdinalIgnoreCase))
            {
                var previewVoice = string.IsNullOrWhiteSpace(voice) ? GetResolvedFallbackVoice() : voice;
                var wav = await Speech.SynthesizePreviewAsync(AppState.Settings.KokoroBaseUrl, previewVoice);
                if (wav is null)
                {
                    _speechTestOk = false;
                    _speechTestResult = "Kokoro preview failed. The service may be offline or still starting.";
                    _canStartKokoroService = true;
                    return;
                }

                await Speech.PlayPreviewAsync(wav, CancellationToken.None);
                _speechTestOk = true;
                _speechTestResult = $"Playing {label}.";
                return;
            }

            if (string.Equals(provider, Piper, StringComparison.OrdinalIgnoreCase) && string.IsNullOrWhiteSpace(voice))
            {
                _speechTestOk = false;
                _speechTestResult = "Piper previews need an explicit voice or model path for this room.";
                return;
            }

            await Speech.SpeakAsync(BuildSpeechSettings(forceEnabled: true), SpeechPreviewSample, voice, CancellationToken.None);
            _speechTestOk = true;
            _speechTestResult = $"Playing {label}.";
        }
        catch (Exception ex)
        {
            _speechTestOk = false;
            _speechTestResult = $"Voice preview failed: {Truncate(ex.Message, 120)}";
        }
        finally
        {
            if (isUserPreview)
                _previewingUserVoice = false;
            else
                _previewingFallbackVoice = false;

            StateHasChanged();
        }
    }

    private async Task TestKokoroConnectionAsync()
    {
        var settings = AppState.Settings;
        var (success, message, canRetry) = await Speech.TestKokoroConnectionAsync(
            settings.KokoroBaseUrl, settings.KokoroModel, GetResolvedFallbackVoice());
        _speechTestOk = success;
        _speechTestResult = message;
        _canStartKokoroService = canRetry;
    }

    private void StartKokoroService()
    {
        try
        {
            var kokoroDir = Path.Combine(
                Environment.GetFolderPath(Environment.SpecialFolder.MyDocuments),
                "AgentGroupChat", "Kokoro-FastAPI");

            if (!Directory.Exists(kokoroDir))
            {
                var candidate = Path.GetFullPath(Path.Combine(AppContext.BaseDirectory, "..", "..", "..", "..", "..", "..", "..", "Kokoro-FastAPI"));
                if (Directory.Exists(candidate))
                    kokoroDir = candidate;
            }

            var scriptPath = Path.Combine(kokoroDir + "\\start-cpu.ps1");
            if (!File.Exists(scriptPath))
            {
                _speechTestOk = false;
                _speechTestResult = $"start-cpu.ps1 not found at {kokoroDir}";
                return;
            }

            var psi = new System.Diagnostics.ProcessStartInfo
            {
                FileName = "powershell",
                Arguments = $"-ExecutionPolicy Bypass -File \"{scriptPath}\"",
                WorkingDirectory = kokoroDir,
                UseShellExecute = true,
            };
            System.Diagnostics.Process.Start(psi);
            _speechTestOk = false;
            _speechTestResult = "Kokoro is starting in a new window. Wait a moment, then test again.";
        }
        catch (Exception ex)
        {
            _speechTestOk = false;
            _speechTestResult = $"Failed to start Kokoro: {Truncate(ex.Message, 120)}";
        }
    }

    private static string Truncate(string text, int maxLength) =>
        text.Length <= maxLength ? text : text[..maxLength] + "...";

    private async Task NotifySpeechSettingsChangedAsync()
    {
        if (OnSpeechSettingsChanged is not null)
            await OnSpeechSettingsChanged();
    }
}