<Window x:Class="AgentGroupChat.LogsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AgentGroupChat"
        mc:Ignorable="d"
        Title="Agent Group Chat Logs"
        Height="760"
        Width="1180"
        MinHeight="360"
        MinWidth="720"
        Background="#F4EFE6">
    <Grid Margin="18">
        <Border Background="#FFF9F1"
                CornerRadius="24"
                Padding="18"
                BorderBrush="#E4D6C6"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.ColumnSpan="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="240" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Logs"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="#2C221B" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="System notices, API timings, raw request and response payloads, and hidden memory updates appear here instead of inside the main transcript."
                                   TextWrapping="Wrap"
                                   Foreground="#66584C" />
                        <TextBlock Margin="0,10,0,0"
                                   Text="Session Log File"
                                   FontWeight="SemiBold"
                                   Foreground="#46372D" />
                        <TextBox Margin="0,8,0,0"
                                 IsReadOnly="True"
                                 Text="{Binding SessionLogPath, Mode=OneWay}" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Background="#F6EFE6"
                        CornerRadius="18"
                        Padding="14"
                        BorderBrush="#E4D6C6"
                    BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Log Filters"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#2C221B" />
                            <TextBlock Margin="0,4,0,10"
                                       Text="Use these toggles to move from system-only logging to full request and response inspection."
                                       TextWrapping="Wrap"
                                       Foreground="#66584C" />

                            <WrapPanel>
                                <CheckBox Margin="0,0,12,8"
                                          Content="System"
                                          IsChecked="{Binding ShowSystemLogs, Mode=TwoWay}" />
                                <CheckBox Margin="0,0,12,8"
                                          Content="API Timing"
                                          IsChecked="{Binding ShowTimingLogs, Mode=TwoWay}" />
                                <CheckBox Margin="0,0,12,8"
                                          Content="Requests"
                                          IsChecked="{Binding ShowRequestLogs, Mode=TwoWay}" />
                                <CheckBox Margin="0,0,12,8"
                                          Content="Responses"
                                          IsChecked="{Binding ShowResponseLogs, Mode=TwoWay}" />
                                <CheckBox Margin="0,0,0,8"
                                          Content="Memory"
                                          IsChecked="{Binding ShowMemoryLogs, Mode=TwoWay}" />
                            </WrapPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Source"
                                       FontWeight="SemiBold"
                                       Foreground="#46372D" />
                            <ComboBox Margin="0,8,0,0"
                                      ItemsSource="{Binding LogSources}"
                                      SelectedItem="{Binding SelectedLogSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ListBox Grid.Row="4"
                         Grid.Column="0"
                         x:Name="LogsListBox"
                         ItemsSource="{Binding FilteredLogs}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:LogEntry}">
                            <Border Margin="0,0,0,10"
                                    Padding="14"
                                    Background="#F6EFE6"
                                    CornerRadius="16"
                                    BorderBrush="#E4D6C6"
                                    BorderThickness="1">
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <Border DockPanel.Dock="Left"
                                                Background="#E8DDD0"
                                                CornerRadius="10"
                                                Padding="8,3"
                                                Margin="0,0,8,0">
                                            <TextBlock Text="{Binding CategoryText}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#5A493E" />
                                        </Border>
                                        <Border DockPanel.Dock="Left"
                                                Background="#EFE7DB"
                                                CornerRadius="10"
                                                Padding="8,3"
                                                Margin="0,0,8,0">
                                            <TextBlock Text="{Binding SourceText}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#5A493E" />
                                        </Border>
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding TimestampText}"
                                                   FontSize="12"
                                                   Foreground="#7A6A5D"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Margin="0,8,0,0"
                                               Text="{Binding Message}"
                                               TextWrapping="Wrap"
                                               Foreground="#2F271F"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,6,0,0"
                                               Text="{Binding DurationText}"
                                               Foreground="#7A6A5D">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DurationMilliseconds}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Expander Margin="0,8,0,0"
                                              Header="Details"
                                              IsExpanded="False">
                                        <Expander.Style>
                                            <Style TargetType="Expander">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasDetail}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Expander.Style>
                                        <TextBox Margin="0,8,0,0"
                                                 IsReadOnly="True"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 MinHeight="80"
                                                 Text="{Binding Detail, Mode=OneWay}" />
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                    <Grid Grid.Row="4"
                        Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Background="#F6EFE6"
                            CornerRadius="18"
                            Padding="14"
                            BorderBrush="#E4D6C6"
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Text="Shared Room Memory"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#2C221B" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="The hidden current-state memory block that all agents share between rounds."
                                           TextWrapping="Wrap"
                                           Foreground="#66584C" />
                            </StackPanel>

                            <TextBox Grid.Row="2"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="{Binding SharedRoomMemoryDisplay, Mode=OneWay}" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Background="#F6EFE6"
                            CornerRadius="18"
                            Padding="14"
                            BorderBrush="#E4D6C6"
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Text="Durable Memory"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#2C221B" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="Stable world facts and ongoing truths promoted by the hidden summarizer."
                                           TextWrapping="Wrap"
                                           Foreground="#66584C" />
                            </StackPanel>

                            <TextBox Grid.Row="2"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="{Binding ThemeDurableMemoryDisplay, Mode=OneWay}" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>